<UserControl x:Class="StremioVideoCenterControls.MpvPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:player="clr-namespace:StremioVideoCenterControls.Player"
             Background="Black"
             Focusable="True"
             KeyboardNavigation.IsTabStop="True">
    <UserControl.Resources>
        <Style x:Key="PlayerSliderFocusVisualStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="White" BorderThickness="2" CornerRadius="3">
                            <AdornedElementPlaceholder />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayerSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource PlayerSliderFocusVisualStyle}" />
        </Style>
        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DD333333" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EE555555" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="Black">
        <Grid x:Name="VideoHost" Background="Black" />

        <Popup x:Name="ControlsPopup"
               PlacementTarget="{Binding ElementName=RootGrid}"
               Placement="Custom"
               CustomPopupPlacementCallback="ControlsPopupPlacement"
               HorizontalOffset="0"
               VerticalOffset="0"
               AllowsTransparency="True"
               StaysOpen="True"
               IsOpen="False"
               PopupAnimation="None">
            <!--
                This overlay is deliberately a fixed-size surface. The code-behind
                synchronizes its Width/Height with the real player surface so every
                control remains visible at fullscreen and during resize.

                Popup content is a separate PresentationSource from the rest of the
                UserControl, so keyboard events tunnel from THIS Grid down, not from
                the UserControl root. One PreviewKeyDown handler here (Overlay_
                PreviewKeyDown) is enough to catch every key while focus is anywhere
                inside the popup - individual buttons/sliders no longer need their
                own PreviewKeyDown wiring.
            -->
            <Grid x:Name="ControlsOverlay"
                  Background="Transparent"
                  IsHitTestVisible="True"
                  Focusable="False"
                  PreviewKeyDown="Overlay_PreviewKeyDown"
                  MouseMove="Overlay_MouseMove"
                  PreviewMouseDown="Overlay_PreviewMouseDown">

                <!--
                    The whole overlay (gradients, Exit, centre indicator, bottom
                    bar, menus) fades as one surface: MpvPlayer.xaml.cs animates
                    ControlsOverlay.Opacity. The popup itself stays open while
                    faded so keyboard focus is not lost; IsHitTestVisible is
                    switched off while faded so a hidden control can never be
                    clicked by accident.
                -->

                <Grid.RowDefinitions>
                    <RowDefinition Height="120" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="110" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" IsHitTestVisible="False" VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#AA000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border Grid.Row="2" IsHitTestVisible="False" VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#CC000000" />
                            <GradientStop Offset="1" Color="#00000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Top bar: Exit -->
                <Grid Grid.Row="0" Margin="28,24,28,0">
                    <Button x:Name="CloseButton"
                            Style="{StaticResource PlayerButtonStyle}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Content="&#x2190;  Exit"
                            ToolTip="Stop and exit"
                            Click="CloseButton_Click"
                            FontSize="18"
                            Padding="16,0"
                            MinWidth="96"
                            Height="44"
                            Focusable="True" />
                </Grid>

                <!-- Centre play-state INDICATOR. Display only: not a Button, not
                     focusable, not hit-testable, no command logic and no state
                     of its own - MpvPlayer.ApplyPlayState sets its glyph from
                     the same playback state that drives the real Play/Pause
                     button in the bottom bar. -->
                <Grid Grid.Row="1"
                      IsHitTestVisible="False"
                      Focusable="False">
                    <Border x:Name="CenterPlayIndicator"
                            Width="96"
                            Height="96"
                            CornerRadius="48"
                            Background="#99000000"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Focusable="False">
                        <TextBlock x:Name="CenterPlayGlyph"
                                   Text="&#x25B6;"
                                   Foreground="White"
                                   FontSize="38"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Focusable="False" />
                    </Border>
                </Grid>

                <!-- Bottom player bar (single row): Play/Pause, seek -/+10s,
                     mute, volume, current time, seek bar, duration, Audio,
                     Subtitles, Settings, Fullscreen. -->
                <Grid x:Name="BottomControls"
                      Grid.Row="2"
                      Margin="28,0,28,22"
                      VerticalAlignment="Bottom"
                      Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BottomPlayPauseButton"
                            Grid.Column="0"
                            Style="{StaticResource PlayerButtonStyle}"
                            Content="&#x25B6;"
                            ToolTip="Play / Pause"
                            Click="PlayPauseButton_Click"
                            Width="48" Height="44" FontSize="18" Focusable="True" />
                    <Button x:Name="Back10Button"
                            Grid.Column="1"
                            Style="{StaticResource PlayerButtonStyle}"
                            Content="&#x21B6;"
                            ToolTip="Back 10 seconds"
                            Click="RewindButton_Click"
                            Width="44" Height="44" FontSize="18" Focusable="True" />
                    <Button x:Name="Forward10Button"
                            Grid.Column="2"
                            Style="{StaticResource PlayerButtonStyle}"
                            Content="&#x21B7;"
                            ToolTip="Forward 10 seconds"
                            Click="ForwardButton_Click"
                            Width="44" Height="44" FontSize="18" Focusable="True" />
                    <Button x:Name="MuteButton"
                            Grid.Column="3"
                            Style="{StaticResource PlayerButtonStyle}"
                            Content="&#x1F50A;"
                            ToolTip="Mute / Unmute"
                            Click="MuteButton_Click"
                            Margin="10,0,0,0"
                            Width="44" Height="44" FontSize="17" Focusable="True" />
                    <player:PlayerSlider x:Name="VolumeSlider"
                            Grid.Column="4"
                            Style="{StaticResource PlayerSliderStyle}"
                            Minimum="0" Maximum="100" Value="100"
                            Width="100" Height="40"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged"
                            IsMoveToPointEnabled="True"
                            Focusable="True"
                            ToolTip="Volume" />
                    <TextBlock x:Name="CurrentTimeText"
                               Grid.Column="5"
                               Text="00:00"
                               Foreground="White"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               MinWidth="58"
                               Margin="14,0,8,0"
                               FontSize="15" />
                    <player:PlayerSlider x:Name="SeekSlider"
                            Grid.Column="6"
                            Style="{StaticResource PlayerSliderStyle}"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            Height="28"
                            VerticalAlignment="Center"
                            IsMoveToPointEnabled="True"
                            ValueChanged="SeekSlider_ValueChanged"
                            PreviewMouseDown="SeekSlider_PreviewMouseDown"
                            PreviewMouseUp="SeekSlider_PreviewMouseUp"
                            Focusable="True"
                            ToolTip="Seek" />
                    <TextBlock x:Name="DurationText"
                               Grid.Column="7"
                               Text="00:00"
                               Foreground="White"
                               VerticalAlignment="Center"
                               MinWidth="58"
                               Margin="8,0,14,0"
                               FontSize="15" />
                    <Button x:Name="AudioButton"
                            Grid.Column="8"
                            Style="{StaticResource PlayerButtonStyle}"
                            Content="AUD"
                            ToolTip="Audio track"
                            Click="AudioButton_Click"
                            Width="48" Height="44" FontSize="14" Focusable="True" />
                    <Button x:Name="SubtitleButton"
                            Grid.Column="9"
                            Style="{StaticResource PlayerButtonStyle}"
                            Content="CC"
                            ToolTip="Subtitles"
                            Click="SubtitleButton_Click"
                            Width="48" Height="44" FontSize="14" Focusable="True" />
                    <Button x:Name="SettingsButton"
                            Grid.Column="10"
                            Style="{StaticResource PlayerButtonStyle}"
                            Content="&#x2699;"
                            ToolTip="Settings"
                            Click="SettingsButton_Click"
                            Width="44" Height="44" FontSize="17" Focusable="True" />
                    <Button x:Name="FullscreenButton"
                            Grid.Column="11"
                            Style="{StaticResource PlayerButtonStyle}"
                            Content="&#x26F6;"
                            ToolTip="Fullscreen"
                            Click="FullscreenButton_Click"
                            Width="44" Height="44" FontSize="20" Focusable="True" />
                </Grid>

                <!-- Audio/Subtitle/Settings menus render here, above everything
                     else in the popup. Only one is shown at a time; MpvPlayer.xaml.cs
                     swaps Content and pushes/pops the matching focus scope. -->
                <ContentControl x:Name="MenuHost"
                                 Grid.Row="0"
                                 Grid.RowSpan="3"
                                 Visibility="Collapsed"
                                 Focusable="False" />
            </Grid>
        </Popup>
    </Grid>
</UserControl>
