<UserControl x:Class="StremioVideoCenterControls.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StremioVideoCenterControls"
             Focusable="True"
             KeyboardNavigation.IsTabStop="True"
             PreviewKeyDown="SearchView_PreviewKeyDown">

    <UserControl.Resources>

        <!-- Same CloseButtonStyle convention as every other overlay in
             this project - duplicated rather than shared (see
             EpisodeBrowserView/LocalMediaView/CatalogueBrowseView
             remarks). -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="CloseBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#DD333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E91E63" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#E91E63" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0447A" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="White" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            On-screen keyboard task: mouse/touch affordance for opening the
            keyboard deliberately (controller users reach it via A while
            SearchBox has focus instead - see SearchView.xaml.cs's
            OpenKeyboard remarks). Same visual language as SearchButtonStyle
            but neutral-colored so it doesn't compete with Search as the
            row's primary action.
        -->
        <Style x:Key="OpenKeyboardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#24242A" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#E91E63" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="#EE0D0D0F">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="0" Margin="32,28,32,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="5" Height="26" Background="#E91E63" CornerRadius="2" Margin="0,0,14,0" />
                    <TextBlock Text="Search"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!--
                    Dedicated-page Back navigation task: same control/
                    event/style as before - only the visible label
                    changed to a clearly-readable "Back" affordance.
                -->
                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseButtonStyle}"
                        Content="&#x2190; Back"
                        ToolTip="Back to Home"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        MinWidth="92"
                        Height="40"
                        FontSize="14"
                        FontWeight="SemiBold" />
            </Grid>
        </StackPanel>

        <!-- ========================================================= -->
        <!-- SEARCH BAR                                                 -->
        <!-- ========================================================= -->
        <!--
            Real providers only: Cinemeta's own "search" extra on both
            movie/top and series/top (live-verified, ranked and
            functional for both) and Kitsu for anime - no custom
            scraper, no second/duplicate search engine of this
            project's own.
        -->

        <Grid Grid.Row="1" Margin="32,0,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Style="{StaticResource SearchBoxStyle}"
                     VerticalContentAlignment="Center"
                     KeyDown="SearchBox_KeyDown" />

            <!--
                On-screen keyboard task: explicit mouse/touch trigger for
                controller-less pointer users who still want the virtual
                keyboard (e.g. no physical keyboard attached). Placed
                between the text box and Search so tab/visual order still
                reads left-to-right as "type here, or open keyboard, or
                submit".
            -->
            <Button x:Name="OpenKeyboardButton"
                    Grid.Column="1"
                    Content="&#x2328;"
                    ToolTip="Open on-screen keyboard"
                    Style="{StaticResource OpenKeyboardButtonStyle}"
                    Click="OpenKeyboardButton_Click" />

            <Button x:Name="SearchButton"
                    Grid.Column="2"
                    Content="Search"
                    Style="{StaticResource SearchButtonStyle}"
                    Click="SearchButton_Click" />

        </Grid>

        <!-- ========================================================= -->
        <!-- RESULTS                                                    -->
        <!-- ========================================================= -->

        <Grid Grid.Row="2">

            <ScrollViewer x:Name="ResultsScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,0,32,40">
                    <!-- Slice 19A: shown only when some (not all) providers failed but others returned results. -->
                    <TextBlock x:Name="PartialFailureText"
                               Foreground="#E0A458"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="Collapsed" />
                    <controls:MediaSection x:Name="MoviesSection" Title="MOVIES" Visibility="Collapsed" />
                    <controls:MediaSection x:Name="TvSection" Title="TV SHOWS" Visibility="Collapsed" />
                    <controls:MediaSection x:Name="AnimeSection" Title="ANIME" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="PromptText"
                       Text="Type a title and press Enter or Search to look across Movies, TV Shows, and Anime."
                       Foreground="#AAAAAA"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="520"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <TextBlock x:Name="EmptyText"
                       Text="No results found."
                       Foreground="#AAAAAA"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />

            <!-- Slice 19A: a request FAILED (distinct from EmptyText = successful search, no matches). -->
            <TextBlock x:Name="ErrorText"
                       Foreground="#E0A458"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="560"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />

            <TextBlock x:Name="LoadingText"
                       Text="Searching..."
                       Foreground="#CCCCCC"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />

            <!--
                On-screen keyboard task: docked at the bottom of the
                results area (not a full-page overlay) so the search box
                above stays visible while typing, Netflix/console-style.
                Panel.ZIndex explicit rather than relying on declaration
                order - see StremioVideoCenterView.xaml's own remark on
                the Episode Browser Z-order bug this mirrors the lesson
                from: an explicit, higher ZIndex than any ordinary sibling
                content in this Grid (which has none set, i.e. 0) can never
                silently end up underneath something added later.
                Visibility/host add-remove is owned by SearchView.xaml.cs
                (OpenKeyboard/CloseKeyboard), not set here.
            -->
            <controls:OnScreenKeyboardView x:Name="KeyboardOverlay"
                                            Panel.ZIndex="500"
                                            Visibility="Collapsed"
                                            CharacterEntered="KeyboardOverlay_CharacterEntered"
                                            BackspaceRequested="KeyboardOverlay_BackspaceRequested"
                                            ClearRequested="KeyboardOverlay_ClearRequested"
                                            SubmitRequested="KeyboardOverlay_SubmitRequested"
                                            CloseRequested="KeyboardOverlay_CloseRequested" />

        </Grid>

    </Grid>

</UserControl>
