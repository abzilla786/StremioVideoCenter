<UserControl x:Class="StremioVideoCenterControls.CatalogueBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StremioVideoCenterControls"
             Focusable="True"
             KeyboardNavigation.IsTabStop="True"
             PreviewKeyDown="CatalogueBrowseView_PreviewKeyDown">

    <UserControl.Resources>

        <!-- Same CloseButtonStyle convention as every other overlay in
             this project (EpisodeBrowserView/LocalMediaView) - duplicated
             rather than shared, matching the project's existing
             per-overlay style convention. -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="CloseBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#DD333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Persistent hero navigation task: a compact local equivalent of
            StremioVideoCenterView's own NavigationButtonStyle (that style
            lives in StremioVideoCenterView.xaml's own PluginUserControl.
            Resources, not a shared/merged dictionary, so it isn't visible
            from this separate UserControl) - duplicated per this
            project's existing per-overlay style convention (see
            CloseButtonStyle's own remark just above) rather than shared.
        -->
        <Style x:Key="QuickNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E5E5E5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="#24242A" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="#2A1825" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The default ComboBoxItem template doesn't inherit the
             ComboBox's own Background/Foreground (it renders in a
             separate popup) - without this, the dropdown list would
             fall back to the OS theme's light popup rather than this
             app's dark visual language. IsSelected (in addition to the
             existing IsHighlighted, which only tracks mouse-hover/
             arrow-navigated position within an open dropdown) keeps the
             currently-applied filter visibly marked even when it was
             set programmatically (controller/keyboard Up/Down in
             FilterComboStyle's template below moves SelectedIndex
             directly, which never raises a mouse-driven "highlight"). -->
        <Style x:Key="FilterComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,6" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#E91E63" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E91E63" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Controller navigation stabilisation (filter controls task):
             the default OS ComboBox template does NOT template-bind its
             visible "closed" chrome (the ToggleButton part) to the
             Background/Foreground/BorderBrush setters below - only the
             dropdown popup honours them, which is why FilterComboItem
             Style above already had to solve this same problem for the
             popup. Without an explicit ControlTemplate here, the closed
             box renders with the OS theme's own light chrome regardless
             of the setters, which is what made it unreadable against
             this app's dark background. This template reuses every
             existing setter value unchanged (same colours/sizes as
             before) via TemplateBinding - nothing about the visual
             design changes, it simply makes the control actually honour
             the values already specified for it. -->
        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FilterComboItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- FilterBorder is the only visible chrome -
                                 declared directly in this (outer)
                                 template's own namescope (not inside a
                                 further nested template), so
                                 ControlTemplate.Triggers below can target
                                 it by name. FilterToggle beneath is the
                                 mouse hit-target that opens/closes the
                                 dropdown (Opacity 0 - the default
                                 ToggleButton chrome is never seen, but
                                 stays hit-testable, so no separate
                                 template is needed for it). -->
                            <Border x:Name="FilterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock Grid.Column="1"
                                               Text="&#x25BC;"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="9"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ToggleButton x:Name="FilterToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Opacity="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                            <Popup x:Name="FilterPopup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#1A1A1F"
                                        BorderBrush="#55555F"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240"
                                        Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="#2A2A32" />
                            </Trigger>
                            <!-- Obvious focused-state affordance, matching
                                 the same pink-accent focus convention
                                 CloseButtonStyle/LoadMoreButtonStyle in
                                 this file already use, so a controller
                                 user can always tell the filter bar has
                                 focus. Kept while the dropdown is open
                                 too (IsDropDownOpen), since focus remains
                                 logically on the ComboBox throughout. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FilterBorder" Property="BorderBrush" Value="#E91E63" />
                                <Setter TargetName="FilterBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="FilterBorder" Property="BorderBrush" Value="#E91E63" />
                                <Setter TargetName="FilterBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoadMoreButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#25252B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35353D" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#E91E63" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="#EE0D0D0F">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="0" Margin="32,28,32,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="5" Height="26" Background="#E91E63" CornerRadius="2" Margin="0,0,14,0" />
                    <TextBlock x:Name="HeaderText"
                               Text="Movies"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!--
                    Persistent hero navigation task: quick-switch to the
                    other top-level destinations without first closing
                    this page and returning to Home. This page (and
                    AnimeBrowseView/SearchView) is a full-window overlay
                    hosted above StremioVideoCenterView's own Home content
                    (see StremioVideoCenterView.xaml's Panel.ZIndex remarks
                    on MoviesPageHost/TvPageHost/AnimePageHost/
                    SearchPageHost) and StremioVideoCenterView's "most
                    specific overlay wins" input routing gives this page
                    exclusive input ownership while it's open - so Home's
                    own nav bar underneath is neither visible nor
                    reachable from here. Rather than restructure that
                    established routing/layering (out of scope, and
                    exactly what Issue 8's "no arbitrary focus hacks"
                    guards against), this row gives the page its own
                    equivalent entry points, each tearing this page down
                    (reusing the existing Closed-event plumbing) and
                    asking StremioVideoCenterView to open the requested
                    destination next - see CatalogueBrowseView.xaml.cs's
                    NavigationRequested/RaiseNavigationRequested and
                    StremioVideoCenterView.xaml.cs's own
                    ShowCatalogueBrowsePageAsync remarks.
                -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="QuickNavHomeButton"
                            Content="HOME"
                            ToolTip="Back to Home"
                            Style="{StaticResource QuickNavButtonStyle}"
                            Click="QuickNavHomeButton_Click" />

                    <Button x:Name="QuickNavMoviesButton"
                            Content="MOVIES"
                            Style="{StaticResource QuickNavButtonStyle}"
                            Click="QuickNavMoviesButton_Click" />

                    <Button x:Name="QuickNavTvShowsButton"
                            Content="TV SHOWS"
                            Style="{StaticResource QuickNavButtonStyle}"
                            Click="QuickNavTvShowsButton_Click" />

                    <Button x:Name="QuickNavAnimeButton"
                            Content="ANIME"
                            Style="{StaticResource QuickNavButtonStyle}"
                            Click="QuickNavAnimeButton_Click" />

                    <!--
                        Dedicated-page Back navigation task: same control/
                        event/style as before (still x:Name="CloseButton",
                        still Click="CloseButton_Click" raising the existing
                        Closed event StremioVideoCenterView already awaits to
                        tear this page down and return to Home) - only the
                        visible label changed to a clearly-readable "Back"
                        affordance, per that task's requirements.
                    -->
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseButtonStyle}"
                            Content="&#x2190; Back"
                            ToolTip="Back to Home"
                            Click="CloseButton_Click"
                            MinWidth="92"
                            Height="40"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="10,0,0,0" />

                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ========================================================= -->
        <!-- FILTER BAR                                                 -->
        <!-- ========================================================= -->
        <!--
            Rating filter is deliberately not offered - Cinemeta declares
            no rating/minimum-rating extra on any catalog (live-verified
            this slice), so a rating control here would either be fake
            client-side filtering over a partial page or a dead control -
            neither acceptable per this slice's own instructions. See
            CatalogueService's class remarks.
        -->

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="32,0,32,16">

            <TextBlock Text="Genre:" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="GenreCombo"
                      Style="{StaticResource FilterComboStyle}"
                      SelectionChanged="Filter_SelectionChanged" />

            <TextBlock Text="Year:" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" Margin="16,0,8,0" />
            <ComboBox x:Name="YearCombo"
                      Style="{StaticResource FilterComboStyle}"
                      SelectionChanged="Filter_SelectionChanged" />

            <TextBlock x:Name="FilterLimitationText"
                       Text="No rating filter - Cinemeta doesn't support one."
                       Foreground="#666670"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0" />

        </StackPanel>

        <!-- ========================================================= -->
        <!-- CONTENT                                                    -->
        <!-- ========================================================= -->

        <Grid Grid.Row="2" Margin="0,0,0,0">

            <!-- DEFAULT VIEW: Featured / Popular / New rows -->
            <ScrollViewer x:Name="DefaultScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,0,32,40">
                    <controls:MediaSection x:Name="FeaturedSection" Title="FEATURED" />
                    <controls:MediaSection x:Name="PopularSection" Title="POPULAR" />
                    <controls:MediaSection x:Name="NewSection" Title="NEW RELEASES" />
                    <TextBlock x:Name="DefaultEmptyText"
                               Text="No catalogue results are available right now."
                               Foreground="#AAAAAA"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="8,20,8,0" />
                    <!-- Slice 21 (F8): shown only when the default rows
                         all came back empty (a failed load); re-runs the
                         same default-view load. -->
                    <Button x:Name="DefaultRetryButton"
                            Content="Try Again"
                            Style="{StaticResource LoadMoreButtonStyle}"
                            Click="DefaultRetryButton_Click"
                            HorizontalAlignment="Left"
                            Margin="8,12,8,0"
                            Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- FILTERED VIEW: single grid + Load More -->
            <ScrollViewer x:Name="FilteredScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel Margin="24,0,24,40">

                    <ItemsControl x:Name="FilteredItemsControl" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:MediaCard Focusable="True"
                                                     IsTabStop="False"
                                                     FocusVisualStyle="{x:Null}"
                                                     DataContext="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="FilteredEmptyText"
                               Text="No results for this filter. If this looks wrong, check your connection and choose the filter again."
                               Foreground="#AAAAAA"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="8,20,8,0" />

                    <Button x:Name="LoadMoreButton"
                            Content="Load More"
                            Style="{StaticResource LoadMoreButtonStyle}"
                            Click="LoadMoreButton_Click"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0"
                            Visibility="Collapsed" />

                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="LoadingText"
                       Text="Loading..."
                       Foreground="#CCCCCC"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />

        </Grid>

    </Grid>

</UserControl>
