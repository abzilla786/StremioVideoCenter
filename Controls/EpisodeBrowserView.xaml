<UserControl x:Class="StremioVideoCenterControls.EpisodeBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             KeyboardNavigation.IsTabStop="True"
             PreviewKeyDown="EpisodeBrowserView_PreviewKeyDown">

    <UserControl.Resources>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="CloseBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#DD333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Season row style - now a vertical list item rather than a
            horizontal chip. Focus highlighting (pink border) is unchanged
            from before; the persistent "this season is active" indicator
            is a separate Border added directly into each button's content
            (see BuildSeasonButton) so it stays visible even when focus
            moves away to the episode panel.
        -->
        <Style x:Key="SeasonRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E91E63" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2530" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#24242A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EpisodeCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Stretch" />
                            </Border>
                            <Border x:Name="AccentBar"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,8"
                                    CornerRadius="2"
                                    Background="#E91E63"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E91E63" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2530" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#24242A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            My List button style (Slice 17B; also used by the Source Selector). Same Border/ControlTemplate
            shape and same focus/hover triggers as CloseButtonStyle above -
            kept as its own local style rather than sharing CloseButtonStyle
            because this button shows text content and needs auto width
            and padding instead of a fixed 40x40 glyph box.
        -->
        <Style x:Key="MyListButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MyListBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="MyListBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="MyListBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MyListBorder" Property="Background" Value="#DD333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#EE0D0D0F">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER (unchanged position - stays at the top)             -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="0" Margin="32,28,32,20">

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="5"
                            Height="26"
                            Background="#E91E63"
                            CornerRadius="2"
                            Margin="0,0,14,0" />
                    <TextBlock x:Name="HeaderText"
                               Text="Select a Season"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <!-- Series-level My List (TV/Anime). Toggles the show,
                         never an individual episode. -->
                    <Button x:Name="MyListButton"
                            Style="{StaticResource MyListButtonStyle}"
                            Content="+ MY LIST"
                            ToolTip="Add to My List"
                            Click="MyListButton_Click"
                            Height="40"
                            Margin="0,0,12,0" />

                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseButtonStyle}"
                            Content="&#x2715;"
                            ToolTip="Close"
                            Click="CloseButton_Click"
                            Width="40"
                            Height="40"
                            FontSize="18" />

                </StackPanel>
            </Grid>

            <TextBlock x:Name="ShowInfoText"
                       Foreground="#AAAAAA"
                       FontSize="16"
                       TextWrapping="Wrap"
                       Margin="19,10,0,0"
                       Visibility="Collapsed" />

        </StackPanel>

        <!-- ========================================================= -->
        <!-- BROWSER CONTENT (two independently-scrollable panels)      -->
        <!-- ========================================================= -->
        <!--
            Row height stays "*" (fills remaining space after the Auto
            header row) rather than Auto - this is what keeps the whole
            browser fixed within its host instead of becoming a page-level
            scrolling surface. Each panel's own ScrollViewer clips/scrolls
            its own content within that fixed space; neither panel can
            grow the outer row.
        -->
        <Grid x:Name="BrowserContentGrid"
              Grid.Row="1"
              Margin="32,0,32,28">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- SEASON PANEL (left, vertical, independently        -->
            <!-- scrollable)                                        -->
            <!-- ================================================= -->

            <ScrollViewer x:Name="SeasonListScrollViewer"
                          Grid.Column="0"
                          Margin="0,0,16,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel x:Name="SeasonListPanel" />

            </ScrollViewer>

            <!-- ================================================= -->
            <!-- EPISODE PANEL (right, fills remaining width,       -->
            <!-- independently scrollable)                          -->
            <!-- ================================================= -->

            <ScrollViewer x:Name="EpisodeListScrollViewer"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel x:Name="EpisodeListPanel" />

            </ScrollViewer>

        </Grid>

        <!-- ========================================================= -->
        <!-- EMPTY / ERROR STATE                                        -->
        <!-- ========================================================= -->
        <!--
            Full-overlay state, reserved for the case where the browser
            can't show anything useful at all (no Cinemeta/Kitsu data, no seasons
            found, initial load failure). A single season's episodes
            failing to load no longer uses this - that's now an inline
            message inside the episode panel (see ShowEpisodePanelMessage)
            so the season list stays visible and usable.
        -->

        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">

            <TextBlock x:Name="EmptyStateText"
                       Text="No seasons found."
                       Foreground="#CCCCCC"
                       FontSize="16"
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="420"
                       TextAlignment="Center" />

            <Button x:Name="EmptyStateBackButton"
                    Style="{StaticResource CloseButtonStyle}"
                    Content="Back"
                    Click="CloseButton_Click"
                    Width="100"
                    Height="36"
                    HorizontalAlignment="Center" />

        </StackPanel>

    </Grid>

</UserControl>
