<UserControl x:Class="StremioVideoCenterControls.MyListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StremioVideoCenterControls"
             Focusable="True"
             KeyboardNavigation.IsTabStop="True"
             PreviewKeyDown="MyListView_PreviewKeyDown">

    <UserControl.Resources>

        <!--
            Same CloseButtonStyle as HistoryView.xaml/LocalMediaView.xaml/
            EpisodeBrowserView.xaml (duplicated rather than shared,
            matching this project's existing per-overlay style
            convention).
        -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="CloseBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#DD333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Same chip visual language as AnimeBrowseView's
            CategoryToggleStyle (Slice 17) - duplicated rather than
            shared, matching this project's existing per-overlay style
            convention. Used for both the Media Type row and the Genre
            row below - both are single-select ("radio") groups, unlike
            Anime's multi-select categories, but the selected/focused/
            hover visual states are identical, so the same template
            applies unchanged.
        -->
        <Style x:Key="MyListChipStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="#E4E4E8" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#E91E63" />
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#E91E63" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#E91E63" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="ChipBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            MY LIST REMOVAL (Slice 17B)

            Mouse-only quick action layered onto each card (built the
            same way ProfileSelectionView already layers its own per-tile
            ProfileDeleteButtonStyle button onto a profile tile, rather
            than adding this onto the shared MediaCard control itself -
            MediaCard is reused unmodified everywhere else in the app and
            must not grow a My-List-specific affordance). Deliberately
            NOT a tab stop (Focusable="False" below, set on the instance)
            - keyboard/controller removal goes through the Delete key /
            Controller X while the card itself is focused instead (see
            MyListView.xaml.cs TryRemoveFocusedResult), so this stays a
            single extra hit-test target rather than a second focusable
            element per grid cell, which would break the existing
            flat-index grid navigation math reused from
            CatalogueBrowseView/AnimeBrowseView.
        -->
        <Style x:Key="RemoveChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#CC000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Remove from My List" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RemoveBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RemoveBorder" Property="Background" Value="#E91E63" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#EE0D0D0F">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="0" Margin="32,28,32,20">

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="5"
                            Height="26"
                            Background="#E91E63"
                            CornerRadius="2"
                            Margin="0,0,14,0" />
                    <TextBlock Text="My List"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseButtonStyle}"
                        Content="&#x2190; Back"
                        ToolTip="Back to Home"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        MinWidth="92"
                        Height="40"
                        FontSize="14"
                        FontWeight="SemiBold" />
            </Grid>

        </StackPanel>

        <!-- ========================================================= -->
        <!-- CONTENT                                                    -->
        <!-- ========================================================= -->

        <ScrollViewer x:Name="PageScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FiltersAndResultsPanel" Margin="32,0,32,40">

                <!-- ================================================= -->
                <!-- FILTERS (hidden entirely while My List has never   -->
                <!-- had anything added - see MyListView.xaml.cs        -->
                <!-- ApplyFilters/UpdateEmptyState)                     -->
                <!-- ================================================= -->

                <StackPanel x:Name="FiltersPanel">

                    <TextBlock Text="Media Type"
                               Foreground="#C8C8CE"
                               FontSize="13"
                               Margin="0,0,0,6" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">

                        <ToggleButton x:Name="AllTypeButton"
                                      Content="ALL"
                                      Style="{StaticResource MyListChipStyle}"
                                      IsChecked="True"
                                      Focusable="True"
                                      Click="MediaTypeChip_Click" />

                        <ToggleButton x:Name="MoviesTypeButton"
                                      Content="MOVIES"
                                      Style="{StaticResource MyListChipStyle}"
                                      Focusable="True"
                                      Click="MediaTypeChip_Click" />

                        <ToggleButton x:Name="TvTypeButton"
                                      Content="TV SHOWS"
                                      Style="{StaticResource MyListChipStyle}"
                                      Focusable="True"
                                      Click="MediaTypeChip_Click" />

                        <ToggleButton x:Name="AnimeTypeButton"
                                      Content="ANIME"
                                      Style="{StaticResource MyListChipStyle}"
                                      Focusable="True"
                                      Click="MediaTypeChip_Click" />

                    </StackPanel>

                    <TextBlock Text="Genre"
                               Foreground="#C8C8CE"
                               FontSize="13"
                               Margin="0,0,0,6" />

                    <ItemsControl x:Name="GenreItemsControl" Focusable="False" Margin="0,0,0,18">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Name}"
                                              Style="{StaticResource MyListChipStyle}"
                                              Focusable="True"
                                              Click="GenreChip_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

                <!-- ================================================= -->
                <!-- RESULTS                                            -->
                <!-- ================================================= -->
                <!--
                    Same WrapPanel + raw MediaCard grid as CatalogueBrowse
                    View's FilteredItemsControl/AnimeBrowseView's
                    KitsuBrowseItemsControl - reused unchanged, including
                    the per-card remove button layered on top (see
                    RemoveChipButtonStyle remarks above).
                -->

                <ItemsControl x:Name="ResultsItemsControl" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <controls:MediaCard Focusable="True"
                                                     IsTabStop="False"
                                                     FocusVisualStyle="{x:Null}"
                                                     DataContext="{Binding}" />

                                <Button Style="{StaticResource RemoveChipButtonStyle}"
                                        Content="&#x2715;"
                                        Focusable="False"
                                        IsTabStop="False"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,16,16,0"
                                        Click="RemoveChipButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyListText"
                           Text="Your list is empty."
                           Foreground="#AAAAAA"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           MaxWidth="640"
                           Visibility="Collapsed"
                           Margin="8,20,8,0" />

                <TextBlock x:Name="NoMatchText"
                           Text="No items match these filters."
                           Foreground="#AAAAAA"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           MaxWidth="640"
                           Visibility="Collapsed"
                           Margin="8,20,8,0" />

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
