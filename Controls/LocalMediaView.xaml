<UserControl x:Class="StremioVideoCenterControls.LocalMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StremioVideoCenterControls"
             Focusable="True"
             KeyboardNavigation.IsTabStop="True"
             PreviewKeyDown="LocalMediaView_PreviewKeyDown">

    <UserControl.Resources>

        <!--
            Same CloseButtonStyle as EpisodeBrowserView.xaml/HistoryView.xaml
            (duplicated rather than shared, matching this project's existing
            per-overlay style convention - see those files' own remarks).
        -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="CloseBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#DD333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar / panel action button. Tag="Active" marks the selected filter. -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#E91E63" />
                    <Setter Property="BorderBrush" Value="#E91E63" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#24242A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#77FFFFFF" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="White" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#E91E63" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="#EE0D0D0F">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="0" Margin="32,28,32,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="5"
                            Height="26"
                            Background="#E91E63"
                            CornerRadius="2"
                            Margin="0,0,14,0" />
                    <TextBlock x:Name="TitleText"
                               Text="Local Files"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseButtonStyle}"
                        Content="&#x2190; Back"
                        ToolTip="Back to Home"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        MinWidth="92"
                        Height="40"
                        FontSize="14"
                        FontWeight="SemiBold" />
            </Grid>
        </StackPanel>

        <!-- ========================================================= -->
        <!-- TOOLBAR                                                    -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1" Margin="32,0,32,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FilterBox"
                     Grid.Column="0"
                     Style="{StaticResource SearchBoxStyle}"
                     VerticalContentAlignment="Center"
                     ToolTip="Filter by title"
                     TextChanged="FilterBox_TextChanged" />

            <Button x:Name="OpenKeyboardButton"
                    Grid.Column="1"
                    Content="&#x2328;"
                    ToolTip="Open on-screen keyboard"
                    Style="{StaticResource ToolButtonStyle}"
                    Padding="12,8"
                    FontSize="16"
                    Click="OpenKeyboardButton_Click" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="FilterAllButton" Content="All" Tag="Active"
                        Style="{StaticResource ToolButtonStyle}" Click="FilterButton_Click" />
                <Button x:Name="FilterMoviesButton" Content="Movies"
                        Style="{StaticResource ToolButtonStyle}" Click="FilterButton_Click" />
                <Button x:Name="FilterTvButton" Content="TV"
                        Style="{StaticResource ToolButtonStyle}" Click="FilterButton_Click" />
                <Button x:Name="FilterUnmatchedButton" Content="Unmatched"
                        Style="{StaticResource ToolButtonStyle}" Click="FilterButton_Click" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RescanButton" Content="Rescan"
                        Style="{StaticResource ToolButtonStyle}" Click="RescanButton_Click" />
                <Button x:Name="RetryButton" Content="Retry unmatched" Visibility="Collapsed"
                        ToolTip="Look up unmatched titles again"
                        Style="{StaticResource ToolButtonStyle}" Click="RetryButton_Click" />
                <Button x:Name="CancelScanButton" Content="Cancel" Visibility="Collapsed"
                        Style="{StaticResource ToolButtonStyle}" Click="CancelScanButton_Click" />
                <Button x:Name="FoldersButton" Content="Folders"
                        Style="{StaticResource ToolButtonStyle}" Click="FoldersButton_Click" />
            </StackPanel>
        </Grid>

        <!-- ========================================================= -->
        <!-- STATUS / PROGRESS                                          -->
        <!-- ========================================================= -->

        <StackPanel x:Name="StatusPanel" Grid.Row="2" Margin="32,0,32,10" Visibility="Collapsed">
            <TextBlock x:Name="StatusText"
                       Foreground="#CCCCCC"
                       FontSize="14"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="ScanProgressBar"
                         Height="4"
                         Margin="0,6,0,0"
                         Minimum="0"
                         Maximum="1"
                         IsIndeterminate="True"
                         Foreground="#E91E63"
                         Background="#33FFFFFF"
                         BorderThickness="0"
                         Visibility="Collapsed" />
        </StackPanel>

        <!-- ========================================================= -->
        <!-- CONTENT                                                    -->
        <!-- ========================================================= -->
        <!--
            The same vertically scrolling WrapPanel grid of raw MediaCards
            as HistoryView/MyListView/CatalogueBrowseView, with the same
            vertical DragScroll attached in the code-behind.
        -->

        <Grid Grid.Row="3">

            <ScrollViewer x:Name="PageScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,0,32,40">
                    <ItemsControl x:Name="ResultsItemsControl" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:MediaCard Focusable="True"
                                                    IsTabStop="False"
                                                    FocusVisualStyle="{x:Null}"
                                                    DataContext="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Empty / loading / disabled / error message, centred. -->
            <StackPanel x:Name="MessagePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="560"
                        Visibility="Collapsed">
                <TextBlock x:Name="MessageText"
                           Foreground="#CCCCCC"
                           FontSize="16"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <Button x:Name="MessageActionButton"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource ToolButtonStyle}"
                        Click="MessageActionButton_Click" />
            </StackPanel>

        </Grid>

        <!-- ========================================================= -->
        <!-- FOLDERS PANEL                                              -->
        <!-- ========================================================= -->

        <Grid x:Name="FoldersPanel"
              Grid.RowSpan="4"
              Panel.ZIndex="600"
              Background="#CC000000"
              Visibility="Collapsed">
            <Border Background="#FF16161A"
                    BorderBrush="#55555F"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="26"
                    MaxWidth="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24">
                <StackPanel>
                    <TextBlock Text="Library folders"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Local Files scans these folders for videos. Folders apply to every profile."
                               Foreground="#AAAAAA"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />

                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FolderItemsControl" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Path}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StateText}"
                                                       Foreground="{Binding StateBrush}"
                                                       FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Remove"
                                                Tag="{Binding Path}"
                                                Style="{StaticResource ToolButtonStyle}"
                                                Click="RemoveFolderButton_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="FoldersEmptyText"
                               Text="No folders yet. Add a folder to build your library."
                               Foreground="#AAAAAA"
                               FontSize="14"
                               Margin="0,0,0,8"
                               Visibility="Collapsed" />

                    <TextBlock x:Name="FoldersNoticeText"
                               Foreground="#E0A458"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="AddFolderButton"
                                Content="Add folder..."
                                Margin="0"
                                Style="{StaticResource ToolButtonStyle}"
                                Click="AddFolderButton_Click" />
                        <Button x:Name="AddFolderWindowsButton"
                                Content="Windows picker..."
                                ToolTip="Use the standard Windows folder dialog (for network shares that are not mapped to a drive)"
                                Style="{StaticResource ToolButtonStyle}"
                                Click="AddFolderWindowsButton_Click" />
                        <Button x:Name="FoldersDoneButton"
                                Content="Done"
                                Style="{StaticResource ToolButtonStyle}"
                                Click="FoldersDoneButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- ITEM OPTIONS PANEL                                         -->
        <!-- ========================================================= -->

        <Grid x:Name="OptionsPanel"
              Grid.RowSpan="4"
              Panel.ZIndex="700"
              Background="#CC000000"
              Visibility="Collapsed">
            <Border Background="#FF16161A"
                    BorderBrush="#55555F"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="26"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="OptionsTitleText"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="OptionsDetailText"
                               Foreground="#AAAAAA"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,4,0,14" />
                    <Button x:Name="OptionPlayButton" Content="Play" Margin="0,0,0,8"
                            HorizontalContentAlignment="Left"
                            Style="{StaticResource ToolButtonStyle}" Click="OptionPlayButton_Click" />
                    <Button x:Name="OptionDetailsButton" Content="Open details" Margin="0,0,0,8"
                            HorizontalContentAlignment="Left"
                            Style="{StaticResource ToolButtonStyle}" Click="OptionDetailsButton_Click" />
                    <Button x:Name="OptionFixMatchButton" Content="Fix match..." Margin="0,0,0,8"
                            HorizontalContentAlignment="Left"
                            Style="{StaticResource ToolButtonStyle}" Click="OptionFixMatchButton_Click" />
                    <Button x:Name="OptionKeepUnmatchedButton" Content="Keep as unmatched" Margin="0,0,0,8"
                            HorizontalContentAlignment="Left"
                            Style="{StaticResource ToolButtonStyle}" Click="OptionKeepUnmatchedButton_Click" />
                    <Button x:Name="OptionsCloseButton" Content="Close" Margin="0"
                            HorizontalContentAlignment="Left"
                            Style="{StaticResource ToolButtonStyle}" Click="OptionsCloseButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- FIX MATCH PANEL                                            -->
        <!-- ========================================================= -->

        <Grid x:Name="MatchPanel"
              Grid.RowSpan="4"
              Panel.ZIndex="800"
              Background="#E6000000"
              Visibility="Collapsed">
            <Border Background="#FF16161A"
                    BorderBrush="#55555F"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="26"
                    MaxWidth="820"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="24,40,24,0">
                <StackPanel>
                    <TextBlock x:Name="MatchTitleText"
                               Text="Fix match"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock x:Name="MatchSubtitleText"
                               Foreground="#AAAAAA"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,4,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MatchSearchBox"
                                 Grid.Column="0"
                                 Style="{StaticResource SearchBoxStyle}"
                                 VerticalContentAlignment="Center"
                                 KeyDown="MatchSearchBox_KeyDown" />
                        <Button x:Name="MatchKeyboardButton"
                                Grid.Column="1"
                                Content="&#x2328;"
                                ToolTip="Open on-screen keyboard"
                                Padding="12,8"
                                FontSize="16"
                                Style="{StaticResource ToolButtonStyle}"
                                Click="MatchKeyboardButton_Click" />
                        <Button x:Name="MatchSearchButton"
                                Grid.Column="2"
                                Content="Search"
                                Style="{StaticResource ToolButtonStyle}"
                                Click="MatchSearchButton_Click" />
                    </Grid>

                    <TextBlock x:Name="MatchStatusText"
                               Foreground="#CCCCCC"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,10,0,6" />

                    <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MatchCandidatesControl" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}"
                                            Margin="0,0,0,6"
                                            HorizontalContentAlignment="Left"
                                            Style="{StaticResource ToolButtonStyle}"
                                            Click="MatchCandidateButton_Click">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Foreground="#AAAAAA" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button x:Name="MatchCloseButton"
                            Content="Cancel"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="MatchCloseButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- In-app folder browser (controller-friendly "Add folder"). -->
        <controls:FolderBrowserView x:Name="FolderBrowser"
                                    Grid.RowSpan="4"
                                    Panel.ZIndex="850"
                                    Visibility="Collapsed"
                                    FolderChosen="FolderBrowser_FolderChosen"
                                    Cancelled="FolderBrowser_Cancelled" />

        <!-- On-screen keyboard (shared by the filter box and the match search). -->
        <controls:OnScreenKeyboardView x:Name="KeyboardOverlay"
                                       Grid.RowSpan="4"
                                       Panel.ZIndex="900"
                                       Visibility="Collapsed"
                                       CharacterEntered="KeyboardOverlay_CharacterEntered"
                                       BackspaceRequested="KeyboardOverlay_BackspaceRequested"
                                       ClearRequested="KeyboardOverlay_ClearRequested"
                                       SubmitRequested="KeyboardOverlay_SubmitRequested"
                                       CloseRequested="KeyboardOverlay_CloseRequested" />

    </Grid>

</UserControl>
