<UserControl x:Class="StremioVideoCenterControls.ProfileSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StremioVideoCenterControls"
             Focusable="True"
             KeyboardNavigation.IsTabStop="True"
             PreviewKeyDown="ProfileSelectionView_PreviewKeyDown">

    <!--
        =========================================================
        PROFILE SELECTION VIEW (Slice 16A - Profile Foundation)
        =========================================================

        Shared Netflix-style "Who's watching?" overlay, used for BOTH:
          - application startup (before Home ever loads)
          - the SWITCH PROFILE hero-nav entry, mid-session

        One implementation, two callers (see StremioVideoCenterView.
        ShowProfileSelectionAsync) - the Slice 16 spec is explicit that
        these must not be two separate implementations.

        There is deliberately no Cancel/Back affordance on this view -
        same as Netflix's own profile picker: the user always leaves this
        screen by selecting a profile (even re-selecting the one already
        active, which is a legitimate "no-op switch"). B/Escape are
        consumed as a no-op rather than closing anything (see
        HandleControllerInput/PreviewKeyDown below) so this overlay can
        never be dismissed into an application state with no profile
        chosen.

        Tiles are built in code-behind (ProfileSelectionView.xaml.cs -
        BuildProfileTiles), the same convention OnScreenKeyboardView
        already uses for its own generated key rows, because the tile
        count varies (1-5 profiles, plus an Add Profile tile) rather than
        being fixed XAML content.
    -->

    <UserControl.Resources>

        <Style x:Key="ProfileTileButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="ProfileRenameButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RenameBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--
                                16A fix #1 (focus indication): mirrors
                                NavigationButtonStyle's own IsKeyboardFocused
                                treatment (white border + a tinted
                                background, not just a border colour change)
                                so this small button reads as "focused" as
                                unambiguously as the top nav bar does.
                            -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RenameBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="RenameBorder" Property="Background" Value="#2A1825" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RenameBorder" Property="Background" Value="#1A1A1F" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            16A fix #2 (profile deletion): same small-button template as
            ProfileRenameButtonStyle, but with a destructive (red) accent -
            there is no existing "danger" colour convention elsewhere in
            the app yet (no delete/remove affordance existed before this
            fix), so this introduces the minimum needed - the same shape,
            padding, and font as every other small profile-tile button,
            just a red accent instead of the neutral grey/pink ones.
        -->
        <Style x:Key="ProfileDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C97575" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#5A3A3A" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DeleteBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DeleteBorder" Property="BorderBrush" Value="#F0447A" />
                                <Setter TargetName="DeleteBorder" Property="Background" Value="#2A1515" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DeleteBorder" Property="Background" Value="#241717" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            16A fix #2: the confirm-delete primary action - same shape as
            ProfilePrimaryButtonStyle, red instead of pink, so it reads as
            destructive without inventing a whole second button language.
        -->
        <Style x:Key="ProfileDangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C0392B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#C0392B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D9483A" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="White" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileNameBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="ProfilePrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E91E63" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#E91E63" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0447A" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="White" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#24242A" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#E91E63" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Focus ring used on the avatar circle itself (select tiles /
             Add Profile tile) - applied from code-behind (BuildProfileTile/
             BuildAddProfileTile) via PreviewGotKeyboardFocus/PreviewLost
             KeyboardFocus and MouseEnter/MouseLeave, the same technique
             MediaCard already uses for its own CardBorder, since these
             avatar Borders are built as plain content, not a Button
             ControlTemplate part. Kept here only as a documented colour
             reference for that code. -->

        <!--
            16A keyboard-activation fix: mirrors SearchView's own
            OpenKeyboardButtonStyle exactly (same colours, same triggers) -
            duplicated rather than shared, same "Same CloseButtonStyle
            convention as every other overlay in this project - duplicated
            rather than shared" precedent SearchView.xaml itself documents
            for its own CloseButtonStyle. This is the mouse/touch
            affordance ProfileSelectionView was missing: previously the
            on-screen keyboard could only be opened via controller A/Enter
            while ProfileNameBox had focus (ActivateFocusedControl), with
            no equivalent for a mouse-only user - SearchView has always had
            OpenKeyboardButton for exactly this case.
        -->
        <Style x:Key="OpenKeyboardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#24242A" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#E91E63" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="#EE0D0D0F">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- TITLE                                                      -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40">
            <TextBlock Text="WHO'S WATCHING?"
                       Foreground="White"
                       FontSize="34"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="SwitchingSubtitleText"
                       Text="Select a profile to continue"
                       Foreground="#AAAAAA"
                       FontSize="15"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- ========================================================= -->
        <!-- PROFILE TILES (built in code-behind)                       -->
        <!-- ========================================================= -->

        <StackPanel x:Name="ProfileTilesPanel"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

        <!-- ========================================================= -->
        <!-- NAME ENTRY PANEL (Add / Rename - Slice 15's on-screen      -->
        <!-- keyboard convention, reused as-is)                         -->
        <!-- ========================================================= -->

        <Border x:Name="NameEntryPanel"
                Grid.Row="0" Grid.RowSpan="3"
                Panel.ZIndex="10"
                Background="#F20D0D0F"
                Visibility="Collapsed">

            <!--
                16A keyboard-clipping fix: this outer StackPanel is
                deliberately width-UNconstrained (see root-cause notes
                below) - it exists only so the name-entry block and the
                keyboard stack vertically and both stay horizontally
                centred in the overlay, which is exactly what the single
                MaxWidth="520" StackPanel used to do until the keyboard
                was added as its last child.

                ROOT CAUSE (found before this fix): OnScreenKeyboardView's
                key rows use fixed per-key pixel widths (Width="52" per
                letter/number key, MinWidth 90/120/300 on the wide action
                keys, each with the KeyButtonStyle's own 4px margin on
                every side) - see Controls/OnScreenKeyboardView.xaml. That
                gives the control a genuine, unavoidable minimum content
                width of roughly 780px (its widest row, the bottom letter
                row: Shift 98 + 9 keys x 60 + Backspace 98 = 736px, plus
                the outer 24px side margins in its own XAML). This control
                was previously nested inside NameEntryPanel's single
                MaxWidth="520" StackPanel alongside the name field and
                Save/Cancel buttons, which is where SearchView never had a
                problem (SearchPageHost gives SearchView's own keyboard
                the full page width) but here clipped roughly 260px off
                each side. So this was case C - both the keyboard's own
                fixed-width rows AND this host's narrower container - not
                a bug in the keyboard control itself, so
                OnScreenKeyboardView.xaml/.xaml.cs are unchanged.

                FIX: split the name-entry block (title/textbox/error/Save-
                Cancel - still exactly MaxWidth="520", unaffected/
                unmoved) from the keyboard into two children of this wider,
                unconstrained outer StackPanel, so the keyboard is free to
                lay out at its real content width and still ends up
                horizontally centred in the overlay (HorizontalAlignment=
                "Center" on both children, same as before) - no key
                sizing, no proportional/UniformGrid rework, and no visual
                change to SearchView's own keyboard.
            -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <StackPanel HorizontalAlignment="Center" MaxWidth="520">

                    <TextBlock x:Name="NameEntryTitleText"
                               Text="Add Profile"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <!--
                        16A keyboard-activation fix: TextBox + keyboard-open
                        button share a row, same column shape as SearchView's
                        SearchBox/OpenKeyboardButton pair (TextBox in the "*"
                        column, button in "Auto" beside it). OpenKeyboardButton
                        Click="OpenKeyboardButton_Click" is a plain, non-nested
                        call to the existing, unchanged OpenKeyboard() - same
                        wiring shape as SearchView.OpenKeyboardButton_Click.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ProfileNameBox"
                                 Grid.Column="0"
                                 Style="{StaticResource ProfileNameBoxStyle}"
                                 VerticalContentAlignment="Center"
                                 MaxLength="24"
                                 KeyDown="ProfileNameBox_KeyDown" />

                        <Button x:Name="OpenKeyboardButton"
                                Grid.Column="1"
                                Content="&#x2328;"
                                ToolTip="Open on-screen keyboard"
                                Style="{StaticResource OpenKeyboardButtonStyle}"
                                Click="OpenKeyboardButton_Click" />
                    </Grid>

                    <TextBlock x:Name="NameEntryErrorText"
                               Foreground="#F0447A"
                               FontSize="13"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button x:Name="SaveNameButton"
                                Content="Save"
                                Style="{StaticResource ProfilePrimaryButtonStyle}"
                                Click="SaveNameButton_Click" />
                        <Button x:Name="CancelNameButton"
                                Content="Cancel"
                                Style="{StaticResource ProfileSecondaryButtonStyle}"
                                Click="CancelNameButton_Click" />
                    </StackPanel>

                </StackPanel>

                <!--
                    On-screen keyboard task (reused): docked below the
                    name field so controller-only users can type a
                    profile name, same control/event wiring SearchView
                    already established. Deliberately OUTSIDE the
                    MaxWidth="520" block above - see this Border's own
                    root-cause remarks.
                -->
                <controls:OnScreenKeyboardView x:Name="KeyboardOverlay"
                                                Margin="0,24,0,0"
                                                HorizontalAlignment="Center"
                                                Visibility="Collapsed"
                                                CharacterEntered="KeyboardOverlay_CharacterEntered"
                                                BackspaceRequested="KeyboardOverlay_BackspaceRequested"
                                                ClearRequested="KeyboardOverlay_ClearRequested"
                                                SubmitRequested="KeyboardOverlay_SubmitRequested"
                                                CloseRequested="KeyboardOverlay_CloseRequested" />

            </StackPanel>

        </Border>

        <!-- ========================================================= -->
        <!-- DELETE CONFIRM PANEL (16A fix #2 - profile deletion)       -->
        <!-- ========================================================= -->
        <!--
            Deliberately a separate confirmation step, not a single click -
            "must require explicit confirmation" / "do not allow accidental
            deletion from a single controller/keyboard activation" (16A fix
            spec). Same overlay-panel shape as NameEntryPanel above so it
            reads as part of the same UI language, just with the danger
            colour on the destructive action.
        -->
        <Border x:Name="DeleteConfirmPanel"
                Grid.Row="0" Grid.RowSpan="3"
                Panel.ZIndex="10"
                Background="#F20D0D0F"
                Visibility="Collapsed">

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">

                <TextBlock Text="Delete Profile?"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14" />

                <TextBlock x:Name="DeleteConfirmNameText"
                           Foreground="#D0D0D0"
                           FontSize="15"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />

                <TextBlock Text="This cannot be undone."
                           Foreground="#C97575"
                           FontSize="13"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button x:Name="ConfirmDeleteButton"
                            Content="Delete Profile"
                            Style="{StaticResource ProfileDangerButtonStyle}"
                            Click="ConfirmDeleteButton_Click" />
                    <Button x:Name="CancelDeleteButton"
                            Content="Cancel"
                            Style="{StaticResource ProfileSecondaryButtonStyle}"
                            Click="CancelDeleteButton_Click" />
                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
