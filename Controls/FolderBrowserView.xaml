<UserControl x:Class="StremioVideoCenterControls.FolderBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <UserControl.Resources>

        <!--
            Same toolbar-button look as LocalMediaView's ToolButtonStyle
            (duplicated rather than shared, matching this project's
            per-overlay style convention). Tag="Active" marks the primary
            action; IsKeyboardFocused draws the white focus ring.
        -->
        <Style x:Key="BrowserButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#E91E63" />
                    <Setter Property="BorderBrush" Value="#E91E63" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#24242A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#77FFFFFF" />
                    <Setter Property="Background" Value="#141417" />
                    <Setter Property="BorderBrush" Value="#33333A" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="White" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="#E6000000">
        <Border Background="#FF16161A"
                BorderBrush="#55555F"
                BorderThickness="1"
                CornerRadius="6"
                Padding="26"
                MaxWidth="860"
                Margin="32"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Choose a library folder"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <!-- The folder that "Select this folder" will add. -->
                <Border Grid.Row="1"
                        Background="#0F0F12"
                        BorderBrush="#E91E63"
                        BorderThickness="0,0,0,2"
                        Padding="12,10"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="CaptionText"
                                   Text="CURRENT FOLDER"
                                   Foreground="#AAAAAA"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="PathText"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText"
                           Grid.Row="2"
                           Foreground="#E0A458"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="Collapsed" />

                <Grid Grid.Row="3">
                    <ScrollViewer x:Name="EntriesScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="EntriesControl" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}"
                                            Margin="0,0,0,6"
                                            HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource BrowserButtonStyle}"
                                            Click="EntryButton_Click">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="White"
                                                       FontSize="15"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="#AAAAAA"
                                                       FontSize="12"
                                                       Visibility="{Binding DetailVisibility}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="EmptyText"
                               Foreground="#AAAAAA"
                               FontSize="15"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            Margin="0,14,0,0">
                    <Button x:Name="UpButton"
                            Content="&#x2191; Up one level"
                            Margin="0"
                            Style="{StaticResource BrowserButtonStyle}"
                            Click="UpButton_Click" />
                    <Button x:Name="SelectButton"
                            Content="Select this folder"
                            Tag="Active"
                            Style="{StaticResource BrowserButtonStyle}"
                            Click="SelectButton_Click" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource BrowserButtonStyle}"
                            Click="CancelButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</UserControl>
