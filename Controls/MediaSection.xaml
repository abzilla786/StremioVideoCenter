<UserControl x:Class="StremioVideoCenterControls.MediaSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StremioVideoCenterControls"
             Focusable="False">

    <StackPanel Margin="0,0,0,35">

        <!-- ===================================================== -->
        <!-- SECTION TITLE + OPTIONAL "MORE" LINK                  -->
        <!-- ===================================================== -->
        <!--
            The More button is opt-in per instance (MoreButtonVisibility
            defaults to Collapsed on MediaSection itself - see
            MediaSection.xaml.cs), so every section that doesn't set it
            renders exactly as before this addition.
        -->

        <DockPanel LastChildFill="True"
                   Margin="8,0,8,12">

            <Button x:Name="MoreButton"
                    DockPanel.Dock="Right"
                    Content="{Binding MoreLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Visibility="{Binding MoreButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Click="MoreButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#B3B3B3"
                    FontSize="14"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    VerticalAlignment="Bottom"
                    Padding="6,0"/>

            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"/>

        </DockPanel>


        <!-- ===================================================== -->
        <!-- MEDIA ROW                                             -->
        <!-- ===================================================== -->

        <ScrollViewer x:Name="MediaScrollViewer"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      Focusable="False"
                      CanContentScroll="False">

            <ItemsControl x:Name="MediaItemsControl"
                          ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Focusable="False">

                <!-- ================================================= -->
                <!-- HORIZONTAL CARD LAYOUT                            -->
                <!-- ================================================= -->

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>

                        <StackPanel Orientation="Horizontal"/>

                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>


                <!-- ================================================= -->
                <!-- CARD TEMPLATE                                     -->
                <!-- ================================================= -->

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <controls:MediaCard
                            Focusable="True"
                            IsTabStop="False"
                            FocusVisualStyle="{x:Null}"
                            DataContext="{Binding}"/>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </StackPanel>

</UserControl>