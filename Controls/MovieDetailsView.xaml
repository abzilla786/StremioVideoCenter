<UserControl x:Class="StremioVideoCenterControls.MovieDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             KeyboardNavigation.IsTabStop="True"
             PreviewKeyDown="MovieDetailsView_PreviewKeyDown"
             SizeChanged="MovieDetailsView_SizeChanged">

    <!--
        MOVIE DETAILS (Slice 19B)

        One adaptive layout - no PC/TV/mobile variants. The poster column
        simply collapses when the available width is narrow (see
        MovieDetailsView_SizeChanged), the same width-driven approach the
        Home hero uses, and every block of text wraps. The page scrolls as a
        whole so a long synopsis can never push the actions off-screen or
        distort the layout.

        Styling follows the existing overlays (Source Selector/Episode
        Browser): near-black background, #E91E63 accent, Border-based button
        templates with a white focus border.
    -->

    <UserControl.Resources>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="CloseBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#DD333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action (Watch Now): accent fill. -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E91E63" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#E91E63" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="28,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Height="46"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#F0407F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action (My List): dark fill. -->
        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Height="46"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="#DD333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#0D0D0F">

        <!-- Backdrop artwork (only when available), dimmed under a gradient. -->
        <Image x:Name="BackdropImage"
               Stretch="UniformToFill"
               Opacity="0.4"
               IsHitTestVisible="False" />

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#990D0D0F" Offset="0" />
                    <GradientStop Color="#EE0D0D0F" Offset="0.55" />
                    <GradientStop Color="#FF0D0D0F" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===================================================== -->
            <!-- TOP BAR                                                -->
            <!-- ===================================================== -->

            <Grid Grid.Row="0" Margin="32,28,32,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="5"
                            Height="26"
                            Background="#E91E63"
                            CornerRadius="2"
                            Margin="0,0,14,0" />
                    <TextBlock Text="Movie"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseButtonStyle}"
                        Content="&#x2715;"
                        ToolTip="Back"
                        Click="CloseButton_Click"
                        Width="40"
                        Height="40"
                        FontSize="18"
                        HorizontalAlignment="Right" />
            </Grid>

            <!-- ===================================================== -->
            <!-- CONTENT (scrolls as a whole)                           -->
            <!-- ===================================================== -->

            <ScrollViewer x:Name="ContentScrollViewer"
                          Grid.Row="1"
                          Margin="32,24,32,28"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid x:Name="ContentGrid"
                      MaxWidth="1280"
                      HorizontalAlignment="Left">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Poster (collapses on narrow widths). The glyph shows
                         when there is no poster or it fails to load. -->
                    <Border x:Name="PosterBorder"
                            Grid.Column="0"
                            Width="260"
                            Height="390"
                            Background="#252529"
                            CornerRadius="8"
                            ClipToBounds="True"
                            Margin="0,0,36,0"
                            VerticalAlignment="Top">
                        <Grid>
                            <TextBlock Text="&#x1F3AC;"
                                       FontSize="48"
                                       Opacity="0.35"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image x:Name="PosterImage"
                                   Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top">

                        <TextBlock x:Name="TitleText"
                                   Foreground="White"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />

                        <TextBlock x:Name="MetaText"
                                   Foreground="#BBBBBB"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Visibility="Collapsed" />

                        <WrapPanel x:Name="GenrePanel"
                                   Margin="0,14,0,0"
                                   Visibility="Collapsed" />

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button x:Name="WatchNowButton"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Content="&#x25B6;  WATCH NOW"
                                    Click="WatchNowButton_Click"
                                    Margin="0,0,14,0" />
                            <Button x:Name="MyListButton"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Content="+ MY LIST"
                                    ToolTip="Add to My List"
                                    Click="MyListButton_Click" />
                        </StackPanel>

                        <TextBlock x:Name="SynopsisHeading"
                                   Text="SYNOPSIS"
                                   Foreground="#E91E63"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Margin="0,28,0,6"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="SynopsisText"
                                   Foreground="#D0D0D0"
                                   FontSize="16"
                                   LineHeight="24"
                                   TextWrapping="Wrap"
                                   MaxWidth="760"
                                   HorizontalAlignment="Left"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="StatusText"
                                   Foreground="#888888"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,0"
                                   Visibility="Collapsed" />

                        <!-- Label/value rows (director, cast, ...) built in code,
                             only for data that actually exists. -->
                        <StackPanel x:Name="DetailsPanel"
                                    Margin="0,22,0,0"
                                    MaxWidth="760"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed" />

                    </StackPanel>

                </Grid>

            </ScrollViewer>

        </Grid>

    </Grid>

</UserControl>
