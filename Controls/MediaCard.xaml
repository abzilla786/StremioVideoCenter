<UserControl x:Class="StremioVideoCenterControls.MediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">

    <Border x:Name="CardBorder"
            Width="190"
            Margin="8"
            Background="#19191C"
            CornerRadius="6"
            Padding="0"
            Focusable="False">

        <Grid>

            <!-- ================================================= -->
            <!-- CARD CONTENT                                      -->
            <!-- ================================================= -->

            <StackPanel>

                <!-- POSTER -->
                <Border Height="285"
                        Background="#252529"
                        CornerRadius="6,6,0,0"
                        ClipToBounds="True">

                    <Grid>

                        <!-- Actual poster -->
                        <Image Source="{Binding PosterImage}"
                               Stretch="UniformToFill"/>

                        <!-- Slice 18B: saved-progress bar for an incomplete
                             Watch State entry (Continue Watching / History).
                             Collapsed unless MediaItem.Progress > 0. -->
                        <Border x:Name="ProgressTrack"
                                Height="4"
                                VerticalAlignment="Bottom"
                                Background="#99000000"
                                Visibility="Collapsed">
                            <Border x:Name="ProgressFill"
                                    Background="#E91E63"
                                    HorizontalAlignment="Stretch"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0" ScaleY="1"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>

                    </Grid>

                </Border>


                <!-- INFORMATION -->
                <StackPanel Margin="10,9,10,10">

                    <TextBlock x:Name="TitleText"
                               Text="{Binding Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,5,0,0">

                        <TextBlock x:Name="YearText"
                                   Text="{Binding Year}"
                                   FontSize="11"
                                   Foreground="#999999"/>

                        <TextBlock Text=" • "
                                   FontSize="11"
                                   Foreground="#666666"/>

                        <TextBlock x:Name="RatingText"
                                   Text="{Binding Rating}"
                                   FontSize="11"
                                   Foreground="#D0D0D0"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>