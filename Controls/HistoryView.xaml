<UserControl x:Class="StremioVideoCenterControls.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StremioVideoCenterControls"
             Focusable="True"
             KeyboardNavigation.IsTabStop="True"
             PreviewKeyDown="HistoryView_PreviewKeyDown">

    <UserControl.Resources>

        <!--
            Same CloseButtonStyle as LocalMediaView.xaml/EpisodeBrowserView.xaml
            (duplicated rather than shared, matching this project's existing
            per-overlay style convention).
        -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="CloseBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#DD333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#EE0D0D0F">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="0" Margin="32,28,32,20">

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="5"
                            Height="26"
                            Background="#E91E63"
                            CornerRadius="2"
                            Margin="0,0,14,0" />
                    <TextBlock Text="History"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseButtonStyle}"
                        Content="&#x2190; Back"
                        ToolTip="Back to Home"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        MinWidth="92"
                        Height="40"
                        FontSize="14"
                        FontWeight="SemiBold" />
            </Grid>

        </StackPanel>

        <!-- ========================================================= -->
        <!-- CONTENT                                                    -->
        <!-- ========================================================= -->
        <!--
            Slice 16C: a single MediaSection reusing the exact same
            row/card rendering path Home already uses (no new card UI,
            no new grid). Since History has no per-row "More" concept and
            can hold up to 200 entries, the section's own horizontal
            scroll is what carries the extra entries - the same way any
            Home row already handles more items than fit on screen.
        -->

        <Grid Grid.Row="1" Margin="32,0,32,32">

            <controls:MediaSection x:Name="HistorySection"
                                    Title="Watched"
                                    VerticalAlignment="Top" />

            <TextBlock x:Name="EmptyStateText"
                       Text="Nothing watched yet. Content you play will appear here."
                       Foreground="#AAAAAA"
                       FontSize="16"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       MaxWidth="640"
                       Visibility="Collapsed" />

        </Grid>

    </Grid>

</UserControl>
