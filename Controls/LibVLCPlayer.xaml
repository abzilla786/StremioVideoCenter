<UserControl x:Class="StremioVideoCenter.Controls.LibVlcPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Black"
             Focusable="True">

    <Grid x:Name="PlayerRoot"
          Background="Black"
          Focusable="True">

        <!-- ========================================================= -->
        <!-- VIDEO VIEW IS CREATED IN CODE                             -->
        <!-- ========================================================= -->

        <Grid x:Name="VideoHost"
              Background="Black"/>

        <!-- ========================================================= -->
        <!-- PLAYER OVERLAY                                            -->
        <!--                                                             -->
        <!-- This Grid is moved into LibVLCSharp's VideoView from      -->
        <!-- code-behind. This is important for WPF airspace handling. -->
        <!-- ========================================================= -->

        <Grid x:Name="PlayerOverlay"
              Background="#01000000"
              Focusable="True">

            <!-- ===================================================== -->
            <!-- TOP BAR                                                -->
            <!-- ===================================================== -->

            <Grid x:Name="TopControls"
                  Height="90"
                  VerticalAlignment="Top">

                <Grid.Background>

                    <LinearGradientBrush
                        StartPoint="0,0"
                        EndPoint="0,1">

                        <GradientStop
                            Color="#E6000000"
                            Offset="0"/>

                        <GradientStop
                            Color="#00000000"
                            Offset="1"/>

                    </LinearGradientBrush>

                </Grid.Background>


                <Grid Margin="28,18,28,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="70"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Button x:Name="BackButton"
                            Grid.Column="0"
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Content="‹"
                            FontSize="36"
                            Foreground="White"
                            Background="#88000000"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1"
                            Focusable="True"
                            IsTabStop="True"
                            ToolTip="Back"
                            Click="BackButton_Click"/>


                    <TextBlock x:Name="PlayerTitleText"
                               Grid.Column="1"
                               Margin="12,8,0,0"
                               VerticalAlignment="Top"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="Now Playing"
                               TextTrimming="CharacterEllipsis"/>

                </Grid>

            </Grid>


            <!-- ===================================================== -->
            <!-- CENTER PLAY                                           -->
            <!-- ===================================================== -->

            <Button x:Name="CenterPlayButton"
                    Width="82"
                    Height="82"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="▶"
                    FontSize="34"
                    Foreground="White"
                    Background="#99000000"
                    BorderBrush="#99FFFFFF"
                    BorderThickness="1"
                    Focusable="True"
                    IsTabStop="True"
                    Click="PlayPauseButton_Click"/>


            <!-- ===================================================== -->
            <!-- BOTTOM CONTROLS                                       -->
            <!-- ===================================================== -->

            <Grid x:Name="BottomControls"
                  Height="175"
                  VerticalAlignment="Bottom">

                <Grid.Background>

                    <LinearGradientBrush
                        StartPoint="0,1"
                        EndPoint="0,0">

                        <GradientStop
                            Color="#F0000000"
                            Offset="0"/>

                        <GradientStop
                            Color="#00000000"
                            Offset="1"/>

                    </LinearGradientBrush>

                </Grid.Background>


                <Grid Margin="36,18,36,20">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="42"/>

                        <RowDefinition Height="58"/>

                        <RowDefinition Height="22"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- TIMELINE                                            -->
                    <!-- ================================================= -->

                    <Slider x:Name="ProgressSlider"
                            Grid.Row="0"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            Height="28"
                            VerticalAlignment="Center"
                            Focusable="True"
                            IsTabStop="True"
                            ToolTip="Seek"
                            PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                            PreviewMouseUp="ProgressSlider_PreviewMouseUp"
                            ValueChanged="ProgressSlider_ValueChanged"/>


                    <!-- ================================================= -->
                    <!-- CONTROL ROW                                         -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="58"/>

                            <ColumnDefinition Width="58"/>

                            <ColumnDefinition Width="58"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="58"/>

                            <ColumnDefinition Width="150"/>

                            <ColumnDefinition Width="58"/>

                        </Grid.ColumnDefinitions>


                        <!-- PLAY -->

                        <Button x:Name="PlayPauseButton"
                                Grid.Column="0"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="▶"
                                FontSize="19"
                                Foreground="White"
                                Background="#33000000"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Focusable="True"
                                IsTabStop="True"
                                ToolTip="Play / Pause"
                                Click="PlayPauseButton_Click"/>


                        <!-- REWIND -->

                        <Button x:Name="RewindButton"
                                Grid.Column="1"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="↶"
                                FontSize="23"
                                Foreground="White"
                                Background="#33000000"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Focusable="True"
                                IsTabStop="True"
                                ToolTip="Rewind 10 seconds"
                                Click="RewindButton_Click"/>


                        <!-- FORWARD -->

                        <Button x:Name="ForwardButton"
                                Grid.Column="2"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="↷"
                                FontSize="23"
                                Foreground="White"
                                Background="#33000000"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Focusable="True"
                                IsTabStop="True"
                                ToolTip="Forward 10 seconds"
                                Click="ForwardButton_Click"/>


                        <!-- TIME -->

                        <TextBlock x:Name="TimeText"
                                   Grid.Column="3"
                                   Margin="18,0,18,0"
                                   VerticalAlignment="Center"
                                   Foreground="#EEEEEE"
                                   FontSize="14"
                                   Text="00:00 / 00:00"/>


                        <!-- MUTE -->

                        <Button x:Name="MuteButton"
                                Grid.Column="4"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="🔊"
                                FontSize="18"
                                Foreground="White"
                                Background="#33000000"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Focusable="True"
                                IsTabStop="True"
                                ToolTip="Mute / Unmute"
                                Click="MuteButton_Click"/>


                        <!-- VOLUME -->

                        <Slider x:Name="VolumeSlider"
                                Grid.Column="5"
                                Width="130"
                                Height="28"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="100"
                                Value="100"
                                Focusable="True"
                                IsTabStop="True"
                                ToolTip="Volume"
                                ValueChanged="VolumeSlider_ValueChanged"/>


                        <!-- FULLSCREEN -->

                        <Button x:Name="FullscreenButton"
                                Grid.Column="6"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="⛶"
                                FontSize="21"
                                Foreground="White"
                                Background="#33000000"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Focusable="True"
                                IsTabStop="True"
                                ToolTip="Fullscreen"
                                Click="FullscreenButton_Click"/>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- STATUS                                              -->
                    <!-- ================================================= -->

                    <TextBlock x:Name="StatusText"
                               Grid.Row="2"
                               Margin="3,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#AAAAAA"
                               FontSize="12"
                               Text=""/>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</UserControl>