<UserControl x:Class="StremioVideoCenterControls.AnimeBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StremioVideoCenterControls"
             Focusable="True"
             KeyboardNavigation.IsTabStop="True"
             PreviewKeyDown="AnimeBrowseView_PreviewKeyDown">

    <UserControl.Resources>

        <!-- Same CloseButtonStyle/FilterComboStyle/LoadMoreButtonStyle
             convention as CatalogueBrowseView - duplicated rather than
             shared, matching this project's existing per-overlay style
             convention (see EpisodeBrowserView/LocalMediaView remarks). -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="CloseBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#DD333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter styling parity fix: replaced with the EXACT
             FilterComboItemStyle CatalogueBrowseView (Movies/TV) uses,
             including its IsSelected trigger (keeps the currently-applied
             filter visibly marked even when set programmatically by
             MoveKitsuFilterDropDownSelection below, which never raises a
             mouse-driven "highlight") - see that file's identical remark.
             The previous version here had no IsSelected trigger and a
             different Padding/FontSize; this page's filters must now
             match Movie/TV's pixel-for-pixel rather than have their own
             divergent readability tweak. -->
        <Style x:Key="FilterComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,6" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#E91E63" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E91E63" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Filter styling parity fix: replaced with the EXACT
             FilterComboStyle CatalogueBrowseView (Movies/TV) uses,
             including its custom ControlTemplate. This is the actual fix
             for the "light/white ComboBox background" readability bug -
             the previous version here had ordinary Setters only (no
             Template), and the default OS ComboBox chrome does not
             template-bind its visible "closed" box to Background/
             Foreground/BorderBrush setters at all - only the dropdown
             popup honoured them, so the closed control always rendered
             with the OS theme's own light chrome regardless of what was
             set. See CatalogueBrowseView's identical remark on this same
             style for the full explanation. Also fixes the A/Enter-does-
             not-open-the-dropdown issue together with the matching
             code-behind (ActivateKitsuFilterCombo/MoveKitsuFilterDropDown
             Selection in AnimeBrowseView.xaml.cs) - the FilterToggle part
             below is only the mouse hit-target; keyboard/controller drive
             IsDropDownOpen directly from code, exactly as Movie/TV do. -->
        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FilterComboItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="FilterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock Grid.Column="1"
                                               Text="&#x25BC;"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="9"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ToggleButton x:Name="FilterToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Opacity="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                            <Popup x:Name="FilterPopup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#1A1A1F"
                                        BorderBrush="#55555F"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240"
                                        Margin="0,2,0,0">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FilterBorder" Property="Background" Value="#2A2A32" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FilterBorder" Property="BorderBrush" Value="#E91E63" />
                                <Setter TargetName="FilterBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="FilterBorder" Property="BorderBrush" Value="#E91E63" />
                                <Setter TargetName="FilterBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#25252B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35353D" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#E91E63" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoadMoreButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#25252B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#35353D" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#E91E63" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Slice 17 addition - one toggle "chip" per Kitsu category,
             population is dynamic (see AnimeBrowseView.xaml.cs
             PopulateCategoryToggles/RegisterDiscoveredCategories),
             never a hard-coded list. Same visual language as the other
             filter controls (dark surface, pink #E91E63 accent on
             selection/focus, matching FilterComboStyle/SearchButtonStyle).
             UI/navigation fix: FontSize bumped (12 -> 13) and unselected
             Foreground contrast raised (#CCCCCC -> #E4E4E8) for
             readability against the dark chip background; selected/
             focused states (below) were already high-contrast and are
             unchanged. -->
        <Style x:Key="CategoryToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="#E4E4E8" />
            <Setter Property="BorderBrush" Value="#55555F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#E91E63" />
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#E91E63" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#E91E63" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="ChipBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Persistent hero navigation task: same local equivalent of
            StremioVideoCenterView's own NavigationButtonStyle as
            CatalogueBrowseView's identical resource - see that file's
            own remark on why this is duplicated here rather than shared.
        -->
        <Style x:Key="QuickNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E5E5E5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="#24242A" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="#2A1825" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="#EE0D0D0F">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->

        <StackPanel Grid.Row="0" Margin="32,28,32,16">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="5" Height="26" Background="#E91E63" CornerRadius="2" Margin="0,0,14,0" />
                    <TextBlock Text="Anime"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!--
                    Persistent hero navigation task: same quick-nav row as
                    CatalogueBrowseView's own header - see that file's
                    NavigationRequested remarks for why this exists.
                -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="QuickNavHomeButton"
                            Content="HOME"
                            ToolTip="Back to Home"
                            Style="{StaticResource QuickNavButtonStyle}"
                            Click="QuickNavHomeButton_Click" />

                    <Button x:Name="QuickNavMoviesButton"
                            Content="MOVIES"
                            Style="{StaticResource QuickNavButtonStyle}"
                            Click="QuickNavMoviesButton_Click" />

                    <Button x:Name="QuickNavTvShowsButton"
                            Content="TV SHOWS"
                            Style="{StaticResource QuickNavButtonStyle}"
                            Click="QuickNavTvShowsButton_Click" />

                    <Button x:Name="QuickNavAnimeButton"
                            Content="ANIME"
                            Style="{StaticResource QuickNavButtonStyle}"
                            Click="QuickNavAnimeButton_Click" />

                    <!--
                        Dedicated-page Back navigation task: same control/
                        event/style as before - only the visible label
                        changed to a clearly-readable "Back" affordance.
                    -->
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseButtonStyle}"
                            Content="&#x2190; Back"
                            ToolTip="Back to Home"
                            Click="CloseButton_Click"
                            MinWidth="92"
                            Height="40"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="10,0,0,0" />

                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ========================================================= -->
        <!-- CONTENT (single scroll - Kitsu Browse only)                -->
        <!-- ========================================================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,0,32,40">

                <!-- =====================================================
                     BROWSE ANIME (Slice 17 - Kitsu locked in as Zino's
                     permanent anime provider)
                     =====================================================
                     Replaces the old Featured/Popular/New
                     rows and the single-row "Popular on Kitsu" row
                     entirely - a genuine, combinable, server-side
                     filtered discovery experience against Kitsu's own
                     API (KitsuService.BrowseAnimeAsync), not another
                     fixed ranked row. Category chips below are
                     populated dynamically from fetched results (see
                     AnimeBrowseView.xaml.cs PopulateCategoryToggles) -
                     never a hard-coded genre list, since Kitsu has no
                     dedicated categories-listing endpoint. Filters only
                     take effect when Apply is pressed (KitsuApplyFilters
                     Button), not on every focus movement or toggle. -->

                <TextBlock Text="Browse Anime"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,6" />

                <TextBlock Text="Combine as many filters as you like, then press Apply - Kitsu receives one combined query rather than Zino downloading its full catalogue."
                           Foreground="#666670"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">

                    <!-- UI/navigation fix: filter label Foreground/FontSize
                         raised (#AAAAAA/12 -> #C8C8CE/13) for readability;
                         ComboBox focus visual now comes from
                         FilterComboStyle's own IsKeyboardFocused trigger
                         above. -->
                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Type" Foreground="#C8C8CE" FontSize="13" Margin="0,0,0,4" />
                        <ComboBox x:Name="KitsuTypeCombo" Style="{StaticResource FilterComboStyle}" Margin="0" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Season" Foreground="#C8C8CE" FontSize="13" Margin="0,0,0,4" />
                        <ComboBox x:Name="KitsuSeasonCombo" Style="{StaticResource FilterComboStyle}" Margin="0" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Year" Foreground="#C8C8CE" FontSize="13" Margin="0,0,0,4" />
                        <ComboBox x:Name="KitsuYearCombo" Style="{StaticResource FilterComboStyle}" Margin="0" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Status" Foreground="#C8C8CE" FontSize="13" Margin="0,0,0,4" />
                        <ComboBox x:Name="KitsuStatusCombo" Style="{StaticResource FilterComboStyle}" Margin="0" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Sort" Foreground="#C8C8CE" FontSize="13" Margin="0,0,0,4" />
                        <ComboBox x:Name="KitsuSortCombo" Style="{StaticResource FilterComboStyle}" Margin="0" />
                    </StackPanel>

                </StackPanel>

                <TextBlock Text="Categories"
                           Foreground="#C8C8CE"
                           FontSize="13"
                           Margin="0,0,0,6" />

                <ItemsControl x:Name="KitsuCategoryItemsControl" Focusable="False" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding Title}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Style="{StaticResource CategoryToggleStyle}"
                                          Focusable="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="KitsuCategoryHintText"
                           Text="More categories appear here as results load."
                           Foreground="#555560"
                           FontSize="11"
                           Margin="0,0,0,14" />

                <Button x:Name="KitsuApplyFiltersButton"
                        Content="Apply Filters"
                        Style="{StaticResource SearchButtonStyle}"
                        Click="KitsuApplyFiltersButton_Click"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,18" />

                <TextBlock x:Name="KitsuBrowseLoadingText"
                           Text="Loading..."
                           Foreground="#CCCCCC"
                           FontSize="14"
                           Margin="8,0,8,12"
                           Visibility="Collapsed" />

                <ItemsControl x:Name="KitsuBrowseItemsControl" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MediaCard Focusable="True"
                                                 IsTabStop="False"
                                                 FocusVisualStyle="{x:Null}"
                                                 DataContext="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="KitsuBrowseEmptyText"
                           Text="No anime found for these filters."
                           Foreground="#AAAAAA"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="8,20,8,0" />

                <Button x:Name="KitsuBrowseLoadMoreButton"
                        Content="Load More"
                        Style="{StaticResource LoadMoreButtonStyle}"
                        Click="KitsuBrowseLoadMoreButton_Click"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Visibility="Collapsed" />

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
