<UserControl x:Class="StremioVideoCenterControls.SourceSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             KeyboardNavigation.IsTabStop="True"
             PreviewKeyDown="SourceSelectorView_PreviewKeyDown">

    <UserControl.Resources>

        <!--
            Close/back button style, matching MpvPlayer's PlayerButtonStyle
            pattern (Border-based template, IsKeyboardFocused/IsMouseOver
            triggers for a visible focus state) - kept local to this file
            per "keep all styling local to SourceSelectorView", not pulled
            into a shared resource.
        -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="CloseBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#DD333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Source item button style. The visible focus/hover states are the
            important part for controller/keyboard navigation - mouse click
            and keyboard/controller activation both end up going through
            this same Button's Click event (see code-behind), so there's
            only ever one selection path. Slice 10: larger corner radius,
            more padding/spacing, and a left accent bar on focus so the
            selected card reads clearly as "this one" rather than relying
            on the border alone.
        -->
        <Style x:Key="SourceItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Stretch" />
                            </Border>
                            <Border x:Name="AccentBar"
                                    Width="4"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,8"
                                    CornerRadius="2"
                                    Background="#E91E63"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E91E63" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2530" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#24242A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#EE0D0D0F">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->
        <!--
            Slice 10: stronger visual hierarchy via a larger heading and an
            accent bar beside it, plus an optional media-context line
            (title/year/type/rating) below - populated only when the
            calling MediaItem actually has that data (see Populate()).
        -->

        <StackPanel Grid.Row="0" Margin="32,28,32,20">

            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="5"
                            Height="26"
                            Background="#E91E63"
                            CornerRadius="2"
                            Margin="0,0,14,0" />
                    <TextBlock Text="Select a Source"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Style="{StaticResource CloseButtonStyle}"
                        Content="&#x2715;"
                        ToolTip="Close"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        Width="40"
                        Height="40"
                        FontSize="18" />
            </Grid>

            <TextBlock x:Name="MediaInfoText"
                       Foreground="#AAAAAA"
                       FontSize="16"
                       TextWrapping="Wrap"
                       Margin="19,10,0,0"
                       Visibility="Collapsed" />

            <!--
                Slice 14: richer episode context, shown instead of
                MediaInfoText when the selected content is a TV episode
                (see PopulateHeader in the code-behind). Thumbnail fallback
                glyph is always present underneath the Image - a missing/
                failed thumbnail just leaves it visible rather than a
                broken-image control.
            -->
            <Grid x:Name="EpisodeContextPanel"
                  Margin="19,14,0,0"
                  Visibility="Collapsed">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="160"
                        Height="90"
                        Background="#252529"
                        CornerRadius="6"
                        ClipToBounds="True"
                        Margin="0,0,20,0"
                        VerticalAlignment="Top">

                    <Grid>
                        <TextBlock Text="&#x1F3AC;"
                                   FontSize="26"
                                   Opacity="0.35"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <Image x:Name="EpisodeThumbnailImage"
                               Stretch="UniformToFill" />
                    </Grid>

                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Top">

                    <TextBlock x:Name="EpisodeCodeText"
                               Foreground="#E91E63"
                               FontSize="13"
                               FontWeight="Bold" />

                    <TextBlock x:Name="EpisodeTitleText"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <TextBlock x:Name="EpisodeMetaText"
                               Foreground="#AAAAAA"
                               FontSize="13"
                               Margin="0,6,0,0" />

                    <TextBlock x:Name="EpisodeOverviewText"
                               Foreground="#999999"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                </StackPanel>

            </Grid>

        </StackPanel>

        <!-- ========================================================= -->
        <!-- SOURCE LIST (populated dynamically, many/one sources)      -->
        <!-- ========================================================= -->

        <ScrollViewer x:Name="SourceListScrollViewer"
                      Grid.Row="1"
                      Margin="32,0,32,28"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="Collapsed">

            <StackPanel x:Name="SourceListPanel" />

        </ScrollViewer>

        <!-- ========================================================= -->
        <!-- EMPTY STATE (zero sources)                                 -->
        <!-- ========================================================= -->

        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">

            <TextBlock Text="&#x1F4FD;"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"
                       Opacity="0.5" />

            <TextBlock Text="No playable sources found."
                       Foreground="#CCCCCC"
                       FontSize="16"
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center" />

            <Button x:Name="EmptyStateBackButton"
                    Style="{StaticResource CloseButtonStyle}"
                    Content="Back"
                    Click="CloseButton_Click"
                    Width="100"
                    Height="36"
                    HorizontalAlignment="Center" />

        </StackPanel>

    </Grid>

</UserControl>
