<UserControl x:Class="StremioVideoCenter.Controls.MediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">

    <Border x:Name="CardBorder"
            Width="170"
            Margin="8"
            Background="#19191C"
            CornerRadius="6"
            Padding="0"
            Focusable="True">

        <StackPanel>

            <!-- Poster -->
            <Border Height="245"
                    Background="#252529"
                    CornerRadius="6,6,0,0">

                <Grid>

                    <TextBlock Text="POSTER"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#666666"
                               FontWeight="Bold"/>

                </Grid>

            </Border>

            <!-- Information -->
            <StackPanel Margin="10,9,10,10">

                <TextBlock x:Name="TitleText"
                           Text="Movie Title"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,5,0,0">

                    <TextBlock x:Name="YearText"
                               Text="2026"
                               FontSize="11"
                               Foreground="#999999"/>

                    <TextBlock Text=" • "
                               FontSize="11"
                               Foreground="#666666"/>

                    <TextBlock x:Name="RatingText"
                               Text="★ 8.5"
                               FontSize="11"
                               Foreground="#D0D0D0"/>

                </StackPanel>

            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>