<PluginUserControl x:Class="StremioVideoCenter.StremioVideoCenterView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:StremioVideoCenterControls"
                   Focusable="True"
                   Background="#0D0D0F">

    <!-- ========================================================= -->
    <!-- RESOURCES                                                   -->
    <!-- ========================================================= -->

    <PluginUserControl.Resources>

        <!-- ========================================================= -->
        <!-- NAVIGATION BUTTON                                         -->
        <!-- ========================================================= -->

        <Style x:Key="NavigationButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#E5E5E5"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="18,10"/>

            <Setter Property="Margin"
                    Value="4,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Foreground"
                            Value="White"/>

                    <Setter Property="Background"
                            Value="#24242A"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocused"
                         Value="True">

                    <Setter Property="Foreground"
                            Value="White"/>

                    <Setter Property="Background"
                            Value="#2A1825"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- PRIMARY BUTTON                                             -->
        <!-- ========================================================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="#E91E63"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="22,12"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FF3D7A"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocused"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FF3D7A"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                    <Setter Property="BorderBrush"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- SECONDARY BUTTON                                           -->
        <!-- ========================================================= -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="#25252B"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#55555F"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="22,12"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#35353D"/>

                    <Setter Property="BorderBrush"
                            Value="#E91E63"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocused"
                         Value="True">

                    <Setter Property="Background"
                            Value="#35353D"/>

                    <Setter Property="BorderBrush"
                            Value="#E91E63"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- HERO CAROUSEL ARROW                                        -->
        <!-- ========================================================= -->

        <Style x:Key="HeroCarouselArrowStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="68"/>

            <Setter Property="Height"
                    Value="110"/>

            <Setter Property="Background"
                    Value="#66000000"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="52"/>

            <Setter Property="FontWeight"
                    Value="Light"/>

            <Setter Property="Opacity"
                    Value="0.35"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Focusable"
                    Value="True"/>

            <Setter Property="IsTabStop"
                    Value="True"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Opacity"
                            Value="1"/>

                    <Setter Property="Background"
                            Value="#99000000"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocused"
                         Value="True">

                    <Setter Property="Opacity"
                            Value="1"/>

                    <Setter Property="Background"
                            Value="#99000000"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- HERO CAROUSEL INDICATOR                                   -->
        <!-- ========================================================= -->

        <Style x:Key="HeroIndicatorButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="4"/>

            <Setter Property="Margin"
                    Value="1,0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>

    </PluginUserControl.Resources>


    <!-- ========================================================= -->
    <!-- MAIN WINDOW                                                 -->
    <!-- ========================================================= -->

    <Grid>

        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">

            <StackPanel>


                <!-- ===================================================== -->
                <!-- TOP NAVIGATION                                         -->
                <!-- ===================================================== -->

                <Border Background="#111114"
                        Padding="32,20">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- ================================================= -->
                        <!-- LOGO                                               -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="STREMIO"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="VIDEO CENTER"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#AAAAAA"
                                       Margin="1,-2,0,0"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- NAVIGATION                                          -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <Button x:Name="HomeButton"
                                    Content="HOME"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"/>

                            <Button x:Name="MoviesButton"
                                    Content="MOVIES"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"
                                    Click="MoviesButton_Click"/>

                            <Button x:Name="TvShowsButton"
                                    Content="TV SHOWS"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"
                                    Click="TvShowsButton_Click"/>

                            <Button x:Name="AnimeButton"
                                    Content="ANIME"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"
                                    Click="AnimeButton_Click"/>

                            <!--
                                Local Media navigation foundation (Cinemeta-
                                First Addon Settings Architecture slice
                                addendum). Local Files is now a core/default
                                addon (see CoreAddonSeedingService), so this
                                entry point exists on every fresh install
                                regardless of TMDB/Torrentio/Comet
                                configuration. Click-wired in
                                StremioVideoCenterView.xaml.cs like every
                                other overlay host below (PlaybackTestHost/
                                SourceSelectorHost/EpisodeBrowserHost).
                            -->
                            <Button x:Name="LocalMediaButton"
                                    Content="LOCAL MEDIA"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"
                                    Click="LocalMediaButton_Click"/>

                            <Button x:Name="NavigationMyListButton"
                                    Content="MY LIST"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"/>

                            <Button x:Name="HistoryButton"
                                    Content="HISTORY"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"/>

                            <Button x:Name="SearchButton"
                                    Content="SEARCH"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"
                                    Click="SearchButton_Click"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ===================================================== -->
                <!-- HERO                                                    -->
                <!-- ===================================================== -->

                <!--
                    Slice 15 hero layout fix: HeroContainer no longer has a
                    fixed Height (was 925, MaxHeight 1000) - a fixed-height
                    Grid clipped/overflowed whenever the synopsis or title
                    needed more than the old HeroContentPanel's fixed 227px
                    (see below), and MaxHeight made that worse by capping
                    growth outright. HeroContainer's height is now driven
                    entirely by its children (HeroCanvas's fixed 698px media
                    frame + HeroContentPanel's own Auto-sized content) -
                    MinHeight keeps the original look for short synopses,
                    but a long title/description now pushes the container
                    (and everything below it, since Home already scrolls in
                    MainScrollViewer) taller instead of being cut off.
                -->
                <Grid x:Name="HeroContainer"
                      MinHeight="750"
                      Margin="0,0,0,25"
                      Background="#0D0D0F">


                    <!-- ================================================= -->
                    <!-- HERO MEDIA                                          -->
                    <!-- ================================================= -->

                    <Grid x:Name="HeroCanvas"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top">


                        <Grid x:Name="HeroMediaFrame"
                              Width="1240"
                              Height="698"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Background="Black"
                              ClipToBounds="True">

                            <!-- ================================================= -->
                            <!-- HERO BACKDROP                                      -->
                            <!--                                                         -->
                            <!-- Stretch Uniform prevents artwork cropping.        -->
                            <!-- ================================================= -->

                            <Image x:Name="HeroBackdropImage"
                                   Source="{Binding CurrentHeroItem.BackdropUrl}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- HERO CAROUSEL CONTROLS                            -->
                        <!--                                                     -->
                        <!-- These sit above the media frame so they remain     -->
                        <!-- clickable even when the MPV player                -->
                        <!-- occupies the media area.                          -->
                        <!-- ================================================= -->

                        <Grid x:Name="HeroCarouselControls"
                              Width="1240"
                              Height="698"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              IsHitTestVisible="True">


                            <!-- ================================================= -->
                            <!-- PREVIOUS                                           -->
                            <!-- ================================================= -->

                            <Button x:Name="HeroPreviousButton"
                                    Content="‹"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource HeroCarouselArrowStyle}"
                                    Click="HeroPreviousButton_Click"
                                    ToolTip="Previous"/>


                            <!-- ================================================= -->
                            <!-- NEXT                                               -->
                            <!-- ================================================= -->

                            <Button x:Name="HeroNextButton"
                                    Content="›"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource HeroCarouselArrowStyle}"
                                    Click="HeroNextButton_Click"
                                    ToolTip="Next"/>

                        </Grid>

                    </Grid>


                    <!-- ===================================================== -->
                    <!-- HERO INFORMATION PANEL                                -->
                    <!-- ===================================================== -->

                    <!--
                        Slice 15 hero layout fix: fixed Height="227" removed
                        (replaced with MinHeight="227", preserving the
                        original look for short synopses) - this is what let
                        a long synopsis/title get silently clipped, since a
                        fixed-height Grid never grows for its content. The
                        inner Grid's first row changed from "*" (stretch-to-
                        fill-and-clip a fixed parent) to "Auto" (size to
                        content) for the same reason - see below.
                    -->
                    <Grid x:Name="HeroContentPanel"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          MinHeight="227"
                          Margin="0,698,0,0"
                          Background="#151225">


                        <Grid Width="1240"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top">

                            <Grid.RowDefinitions>

                                <!--
                                    Auto (was "*"): the title/metadata/
                                    synopsis/buttons row now sizes to its own
                                    content instead of being squeezed into
                                    whatever space happened to be left in a
                                    fixed-height parent. Combined with the
                                    indicators row directly below it also
                                    being Auto, the two can never overlap -
                                    each only ever occupies the space it
                                    actually needs, stacked top-to-bottom.
                                -->
                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>


                            <!-- ================================================= -->
                            <!-- MAIN HERO INFORMATION                              -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="0"
                                  Margin="0,20,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="1.15*"/>

                                    <ColumnDefinition Width="1.55*"/>

                                    <ColumnDefinition Width="1.30*"/>

                                </Grid.ColumnDefinitions>


                                <!-- ================================================= -->
                                <!-- LEFT: TITLE + METADATA                            -->
                                <!-- ================================================= -->

                                <StackPanel Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="0,0,35,0">


                                    <!-- ================================================= -->
                                    <!-- TYPE                                               -->
                                    <!-- ================================================= -->

                                    <TextBlock Text="{Binding CurrentHeroItem.Type}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#FF2A78"
                                               Margin="0,0,0,5"/>


                                    <!-- ================================================= -->
                                    <!-- TITLE                                              -->
                                    <!-- ================================================= -->

                                    <TextBlock Text="{Binding CurrentHeroItem.Title}"
                                               FontSize="38"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               TextWrapping="Wrap"/>


                                    <!-- ================================================= -->
                                    <!-- DYNAMIC METADATA                                   -->
                                    <!-- ================================================= -->

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,8,0,0">

                                        <TextBlock Text="{Binding CurrentHeroItem.Year}"
                                                   FontSize="16"
                                                   Foreground="#BEBEC8"/>

                                        <TextBlock Text="    •    "
                                                   FontSize="16"
                                                   Foreground="#777780"/>

                                        <TextBlock Text="{Binding CurrentHeroItem.Rating}"
                                                   FontSize="16"
                                                   Foreground="#BEBEC8"/>

                                    </StackPanel>

                                </StackPanel>


                                <!-- ================================================= -->
                                <!-- CENTRE: SYNOPSIS                                   -->
                                <!-- ================================================= -->

                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="20,0,35,0">

                                    <TextBlock Text="{Binding CurrentHeroItem.Synopsis}"
                                               FontSize="17"
                                               Foreground="#D0D0D0"
                                               TextWrapping="Wrap"
                                               MaxWidth="500"/>

                                </StackPanel>


                                <!-- ================================================= -->
                                <!-- RIGHT: HERO BUTTONS                                -->
                                <!-- ================================================= -->

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="20,0,0,0">


                                    <!-- ================================================= -->
                                    <!-- WATCH NOW                                          -->
                                    <!-- ================================================= -->

                                    <Button x:Name="HeroWatchNowButton"
                                            Content="▶  WATCH NOW"
                                            Style="{DynamicResource PrimaryButtonStyle}"
                                            Focusable="True"
                                            IsTabStop="True"
                                            MinWidth="175"
                                            MinHeight="52"
                                            FontSize="15"/>


                                    <!-- ================================================= -->
                                    <!-- MY LIST                                            -->
                                    <!-- ================================================= -->

                                    <Button x:Name="HeroMyListButton"
                                            Content="＋  MY LIST"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Focusable="True"
                                            IsTabStop="True"
                                            Margin="14,0,0,0"
                                            MinWidth="150"
                                            MinHeight="52"
                                            FontSize="15"/>

                                </StackPanel>

                            </Grid>


                            <!-- ================================================= -->
                            <!-- HERO CAROUSEL INDICATORS                          -->
                            <!-- ================================================= -->

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,18">


                                <Button x:Name="HeroIndicator1"
                                        Style="{DynamicResource HeroIndicatorButtonStyle}"
                                        Click="HeroIndicator1_Click">

                                    <Ellipse x:Name="HeroIndicatorEllipse1"
                                             Width="9"
                                             Height="9"
                                             Fill="#FF2A78"/>

                                </Button>


                                <Button x:Name="HeroIndicator2"
                                        Style="{DynamicResource HeroIndicatorButtonStyle}"
                                        Click="HeroIndicator2_Click">

                                    <Ellipse x:Name="HeroIndicatorEllipse2"
                                             Width="9"
                                             Height="9"
                                             Fill="#77777F"/>

                                </Button>


                                <Button x:Name="HeroIndicator3"
                                        Style="{DynamicResource HeroIndicatorButtonStyle}"
                                        Click="HeroIndicator3_Click">

                                    <Ellipse x:Name="HeroIndicatorEllipse3"
                                             Width="9"
                                             Height="9"
                                             Fill="#77777F"/>

                                </Button>


                                <Button x:Name="HeroIndicator4"
                                        Style="{DynamicResource HeroIndicatorButtonStyle}"
                                        Click="HeroIndicator4_Click">

                                    <Ellipse x:Name="HeroIndicatorEllipse4"
                                             Width="9"
                                             Height="9"
                                             Fill="#77777F"/>

                                </Button>


                                <Button x:Name="HeroIndicator5"
                                        Style="{DynamicResource HeroIndicatorButtonStyle}"
                                        Click="HeroIndicator5_Click">

                                    <Ellipse x:Name="HeroIndicatorEllipse5"
                                             Width="9"
                                             Height="9"
                                             Fill="#77777F"/>

                                </Button>

                            </StackPanel>
                            
                        </Grid>

                    </Grid>

                </Grid>


                <!-- ===================================================== -->
                <!-- MEDIA CONTENT                                           -->
                <!-- ===================================================== -->

                <!--
                    ===================================================
                    Slice 15 Home restructure.
                    ===================================================
                    Order: HERO (above) -> MY LIST (conditional) ->
                    CONTINUE WATCHING (conditional) -> FEATURED MOVIES ->
                    POPULAR MOVIES -> FEATURED TV -> POPULAR TV ->
                    FEATURED ANIME -> POPULAR ANIME. Replaces the old
                    nine Top10/Trending/RecentlyReleased rows plus the
                    unrelated "Recently Added" row (which was never wired
                    to real data and carried a hardcoded dummy item) -
                    all removed. "New"/Recently-Released content no
                    longer appears on Home at all; it lives only on the
                    dedicated Movies/TV pages (see CatalogueBrowseView).

                    MyListSection/ContinueWatchingSection bind Visibility
                    to HomeViewModel.HasMyList/HasContinueWatching via the
                    built-in BooleanToVisibilityConverter, so an empty
                    collection collapses the section entirely - no empty
                    carousel, no placeholder cards, no reserved vertical
                    space (the StackPanel layout means a Collapsed
                    sibling takes zero height). Both collections start
                    empty this slice (see HomeViewModel remarks) - Slice
                    16 (Watch State) and Slice 17 (My List) are what will
                    ever populate them.

                    Every row below sets MoreButtonVisibility=Visible +
                    MoreLabel="See More →", wired in code-behind to real
                    navigation into the dedicated Movies/TV/Anime pages
                    (StremioVideoCenterView.xaml.cs) - no more
                    placeholder MessageBoxes.
                -->
                <StackPanel Margin="45,0,45,60">

                    <StackPanel.Resources>
                        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
                    </StackPanel.Resources>


                    <!-- ================================================= -->
                    <!-- MY LIST (conditional)                              -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="MyListSection"
                        Title="MY LIST"
                        Items="{Binding MyList}"
                        Visibility="{Binding HasMyList, Converter={StaticResource BoolToVisibilityConverter}}"/>


                    <!-- ================================================= -->
                    <!-- CONTINUE WATCHING (conditional)                    -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="ContinueWatchingSection"
                        Title="CONTINUE WATCHING"
                        Items="{Binding ContinueWatching}"
                        Visibility="{Binding HasContinueWatching, Converter={StaticResource BoolToVisibilityConverter}}"/>


                    <!-- ================================================= -->
                    <!-- FEATURED MOVIES                                    -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="FeaturedMoviesSection"
                        Title="FEATURED MOVIES"
                        Items="{Binding FeaturedMovies}"/>


                    <!-- ================================================= -->
                    <!-- POPULAR MOVIES                                     -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="PopularMoviesSection"
                        Title="POPULAR MOVIES"
                        Items="{Binding PopularMovies}"/>


                    <!-- ================================================= -->
                    <!-- FEATURED TV SHOWS                                  -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="FeaturedShowsSection"
                        Title="FEATURED TV SHOWS"
                        Items="{Binding FeaturedShows}"/>


                    <!-- ================================================= -->
                    <!-- POPULAR TV SHOWS                                   -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="PopularShowsSection"
                        Title="POPULAR TV SHOWS"
                        Items="{Binding PopularShows}"/>


                    <!-- ================================================= -->
                    <!-- FEATURED ANIME                                     -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="FeaturedAnimeSection"
                        Title="FEATURED ANIME"
                        Items="{Binding FeaturedAnime}"/>


                    <!-- ================================================= -->
                    <!-- POPULAR ANIME                                      -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="PopularAnimeSection"
                        Title="POPULAR ANIME"
                        Items="{Binding PopularAnime}"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>
        <!--
            Episode Browser hosting/focus fix: PlaybackTestHost,
            SourceSelectorHost and EpisodeBrowserHost are true modal
            overlays - meant to sit on top of whatever page is currently
            showing (Home, or one of the Slice 15 Movies/TV/Anime/Search
            page hosts below), not to be peers of those pages. They used
            to share the same Panel.ZIndex="1000" as the page hosts added
            in Slice 15. WPF only uses ZIndex to order same-parent
            siblings, and breaks ties between equal ZIndex values by
            Children-collection order (later-added wins) - so whichever
            Slice 15 page host was currently visible (declared after
            these three in this same Grid's Children) always rendered
            and hit-tested on top of an overlay opened from within it.
            Selecting a TV show/anime from the Search/Movies/TV/Anime
            page therefore opened EpisodeBrowserHost "successfully" (its
            Visibility really was Visible, and _activeEpisodeBrowser
            really was set) but it was drawn underneath the still-visible
            page host, invisible and unreachable by mouse hit-testing.
            Raising these three to a higher ZIndex (2000) than every page
            host (which all remain at 1000) makes an overlay always
            render above any page, matching how these hosts are already
            described in this file's own comments (see "other overlay
            host below (PlaybackTestHost/SourceSelectorHost/
            EpisodeBrowserHost)" further up) and how HandleControllerInput
            already treats them as the most-specific, highest-priority
            input target. This is a pure stacking-order change - no
            visibility/lifecycle logic changed.
        -->
        <Grid
            x:Name="PlaybackTestHost"
            Panel.ZIndex="2000"
            Background="Black"
            Visibility="Collapsed" />

        <!-- ========================================================= -->
        <!-- SOURCE SELECTOR HOST (Slice 9)                            -->
        <!-- ========================================================= -->
        <!--
            Separate from PlaybackTestHost even though the two are never
            visible at the same time - the selector is created fresh and
            torn down per selection, while PlaybackTestHost's child
            (_stremioPlayer) is reused across a whole viewing session.
            Sharing one Grid's Children between two differently-lived
            things was judged not worth the small extra XAML to avoid.
        -->
        <Grid
            x:Name="SourceSelectorHost"
            Panel.ZIndex="2000"
            Background="Black"
            Visibility="Collapsed" />

        <!-- ========================================================= -->
        <!-- EPISODE BROWSER HOST (Slice 12)                            -->
        <!-- ========================================================= -->
        <!--
            Same reasoning as SourceSelectorHost being separate from
            PlaybackTestHost: this overlay has its own short-lived
            lifecycle (created fresh per TV-show selection, torn down on
            episode pick or cancellation), distinct from both the player
            and the source selector, so it gets its own host rather than
            sharing either of theirs.
        -->
        <Grid
            x:Name="EpisodeBrowserHost"
            Panel.ZIndex="2000"
            Background="Black"
            Visibility="Collapsed" />

        <!-- ========================================================= -->
        <!-- LOCAL MEDIA HOST (Cinemeta-First Addon Settings Architecture -->
        <!-- slice addendum - navigation foundation only)               -->
        <!-- ========================================================= -->
        <!--
            Same overlay-host pattern as PlaybackTestHost/
            SourceSelectorHost/EpisodeBrowserHost above: a dedicated Grid
            populated dynamically in code-behind (LocalMediaView added/
            removed as a child, Visibility toggled), rather than sharing
            an existing host, since it has its own independent lifecycle.
            This slice adds ONLY the navigation entry point and an empty-
            state view - a full local-media browsing UI depends on Local
            Files catalogue/scan functionality that does not exist yet in
            this codebase (see LocalMediaView.xaml.cs remarks) and is left
            for a dedicated future Local Media slice.
        -->
        <Grid
            x:Name="LocalMediaHost"
            Panel.ZIndex="1000"
            Background="Black"
            Visibility="Collapsed" />

        <!-- ========================================================= -->
        <!-- MOVIES / TV / ANIME / SEARCH PAGE HOSTS (Slice 15)         -->
        <!-- ========================================================= -->
        <!--
            Same overlay-host pattern as every host above: a dedicated
            Grid populated dynamically in code-behind (the page view
            added/removed as a child, Visibility toggled), each with its
            own independent lifecycle - see StremioVideoCenterView.xaml.cs
            ShowMoviesPageAsync/ShowTvPageAsync/ShowAnimePageAsync/
            ShowSearchPageAsync.
        -->
