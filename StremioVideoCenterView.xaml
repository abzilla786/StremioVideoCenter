<PluginUserControl x:Class="StremioVideoCenter.StremioVideoCenterView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:controls="clr-namespace:StremioVideoCenterControls"
                   Focusable="True"
                   Background="#0D0D0F">

    <!-- ========================================================= -->
    <!-- RESOURCES                                                   -->
    <!-- ========================================================= -->

    <PluginUserControl.Resources>

        <!-- ========================================================= -->
        <!-- NAVIGATION BUTTON                                         -->
        <!-- ========================================================= -->

        <Style x:Key="NavigationButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#E5E5E5"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="18,10"/>

            <Setter Property="Margin"
                    Value="4,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Foreground"
                            Value="White"/>

                    <Setter Property="Background"
                            Value="#24242A"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocused"
                         Value="True">

                    <Setter Property="Foreground"
                            Value="White"/>

                    <Setter Property="Background"
                            Value="#2A1825"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- PRIMARY BUTTON                                             -->
        <!-- ========================================================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="#E91E63"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="22,12"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FF3D7A"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocused"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FF3D7A"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                    <Setter Property="BorderBrush"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- SECONDARY BUTTON                                           -->
        <!-- ========================================================= -->

        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="#25252B"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#55555F"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="22,12"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#35353D"/>

                    <Setter Property="BorderBrush"
                            Value="#E91E63"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocused"
                         Value="True">

                    <Setter Property="Background"
                            Value="#35353D"/>

                    <Setter Property="BorderBrush"
                            Value="#E91E63"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- HERO CAROUSEL ARROW                                        -->
        <!-- ========================================================= -->

        <Style x:Key="HeroCarouselArrowStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Width"
                    Value="68"/>

            <Setter Property="Height"
                    Value="110"/>

            <Setter Property="Background"
                    Value="#66000000"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="52"/>

            <Setter Property="FontWeight"
                    Value="Light"/>

            <Setter Property="Opacity"
                    Value="0.35"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Focusable"
                    Value="True"/>

            <Setter Property="IsTabStop"
                    Value="True"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Opacity"
                            Value="1"/>

                    <Setter Property="Background"
                            Value="#99000000"/>

                </Trigger>

                <Trigger Property="IsKeyboardFocused"
                         Value="True">

                    <Setter Property="Opacity"
                            Value="1"/>

                    <Setter Property="Background"
                            Value="#99000000"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- HERO CAROUSEL INDICATOR                                   -->
        <!-- ========================================================= -->

        <Style x:Key="HeroIndicatorButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="4"/>

            <Setter Property="Margin"
                    Value="1,0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>

    </PluginUserControl.Resources>


    <!-- ========================================================= -->
    <!-- MAIN WINDOW                                                 -->
    <!-- ========================================================= -->

    <Grid>

        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">

            <StackPanel>


                <!-- ===================================================== -->
                <!-- TOP NAVIGATION                                         -->
                <!-- ===================================================== -->

                <Border Background="#111114"
                        Padding="32,20">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- ================================================= -->
                        <!-- LOGO                                               -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="STREMIO"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="VIDEO CENTER"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#AAAAAA"
                                       Margin="1,-2,0,0"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- NAVIGATION                                          -->
                        <!-- ================================================= -->

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <Button x:Name="HomeButton"
                                    Content="HOME"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"/>

                            <Button x:Name="MoviesButton"
                                    Content="MOVIES"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"/>

                            <Button x:Name="TvShowsButton"
                                    Content="TV SHOWS"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"/>

                            <Button x:Name="AnimeButton"
                                    Content="ANIME"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"/>

                            <Button x:Name="NavigationMyListButton"
                                    Content="MY LIST"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"/>

                            <Button x:Name="HistoryButton"
                                    Content="HISTORY"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"/>

                            <Button x:Name="SearchButton"
                                    Content="SEARCH"
                                    Style="{DynamicResource NavigationButtonStyle}"
                                    IsTabStop="True"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ===================================================== -->
                <!-- HERO                                                    -->
                <!-- ===================================================== -->

                <Grid x:Name="HeroContainer"
                      Height="925"
                      MinHeight="750"
                      MaxHeight="1000"
                      Margin="0,0,0,25"
                      Background="#0D0D0F">


                    <!-- ================================================= -->
                    <!-- HERO MEDIA                                          -->
                    <!-- ================================================= -->

                    <Grid x:Name="HeroCanvas"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top">


                        <Grid x:Name="HeroMediaFrame"
                              Width="1240"
                              Height="698"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Background="Black"
                              ClipToBounds="True">

                            <!-- ================================================= -->
                            <!-- HERO BACKDROP                                      -->
                            <!--                                                         -->
                            <!-- Stretch Uniform prevents artwork cropping.        -->
                            <!-- ================================================= -->

                            <Image x:Name="HeroBackdropImage"
                                   Source="{Binding CurrentHeroItem.BackdropUrl}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- HERO CAROUSEL CONTROLS                            -->
                        <!--                                                     -->
                        <!-- These sit above the media frame so they remain     -->
                        <!-- clickable even when the MPV player                -->
                        <!-- occupies the media area.                          -->
                        <!-- ================================================= -->

                        <Grid x:Name="HeroCarouselControls"
                              Width="1240"
                              Height="698"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              IsHitTestVisible="True">


                            <!-- ================================================= -->
                            <!-- PREVIOUS                                           -->
                            <!-- ================================================= -->

                            <Button x:Name="HeroPreviousButton"
                                    Content="‹"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource HeroCarouselArrowStyle}"
                                    Click="HeroPreviousButton_Click"
                                    ToolTip="Previous"/>


                            <!-- ================================================= -->
                            <!-- NEXT                                               -->
                            <!-- ================================================= -->

                            <Button x:Name="HeroNextButton"
                                    Content="›"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource HeroCarouselArrowStyle}"
                                    Click="HeroNextButton_Click"
                                    ToolTip="Next"/>

                        </Grid>

                    </Grid>


                    <!-- ===================================================== -->
                    <!-- HERO INFORMATION PANEL                                -->
                    <!-- ===================================================== -->

                    <Grid x:Name="HeroContentPanel"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Height="227"
                          Margin="0,698,0,0"
                          Background="#151225">


                        <Grid Width="1240"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="*"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>


                            <!-- ================================================= -->
                            <!-- MAIN HERO INFORMATION                              -->
                            <!-- ================================================= -->

                            <Grid Grid.Row="0"
                                  Margin="0,20,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="1.15*"/>

                                    <ColumnDefinition Width="1.55*"/>

                                    <ColumnDefinition Width="1.30*"/>

                                </Grid.ColumnDefinitions>


                                <!-- ================================================= -->
                                <!-- LEFT: TITLE + METADATA                            -->
                                <!-- ================================================= -->

                                <StackPanel Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="0,0,35,0">


                                    <!-- ================================================= -->
                                    <!-- TYPE                                               -->
                                    <!-- ================================================= -->

                                    <TextBlock Text="{Binding CurrentHeroItem.Type}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#FF2A78"
                                               Margin="0,0,0,5"/>


                                    <!-- ================================================= -->
                                    <!-- TITLE                                              -->
                                    <!-- ================================================= -->

                                    <TextBlock Text="{Binding CurrentHeroItem.Title}"
                                               FontSize="38"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               TextWrapping="Wrap"/>


                                    <!-- ================================================= -->
                                    <!-- DYNAMIC METADATA                                   -->
                                    <!-- ================================================= -->

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,8,0,0">

                                        <TextBlock Text="{Binding CurrentHeroItem.Year}"
                                                   FontSize="16"
                                                   Foreground="#BEBEC8"/>

                                        <TextBlock Text="    •    "
                                                   FontSize="16"
                                                   Foreground="#777780"/>

                                        <TextBlock Text="{Binding CurrentHeroItem.Rating}"
                                                   FontSize="16"
                                                   Foreground="#BEBEC8"/>

                                    </StackPanel>

                                </StackPanel>


                                <!-- ================================================= -->
                                <!-- CENTRE: SYNOPSIS                                   -->
                                <!-- ================================================= -->

                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="20,0,35,0">

                                    <TextBlock Text="{Binding CurrentHeroItem.Synopsis}"
                                               FontSize="17"
                                               Foreground="#D0D0D0"
                                               TextWrapping="Wrap"
                                               MaxWidth="500"/>

                                </StackPanel>


                                <!-- ================================================= -->
                                <!-- RIGHT: HERO BUTTONS                                -->
                                <!-- ================================================= -->

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="20,0,0,0">


                                    <!-- ================================================= -->
                                    <!-- WATCH NOW                                          -->
                                    <!-- ================================================= -->

                                    <Button x:Name="HeroWatchNowButton"
                                            Content="▶  WATCH NOW"
                                            Style="{DynamicResource PrimaryButtonStyle}"
                                            Focusable="True"
                                            IsTabStop="True"
                                            MinWidth="175"
                                            MinHeight="52"
                                            FontSize="15"/>


                                    <!-- ================================================= -->
                                    <!-- MY LIST                                            -->
                                    <!-- ================================================= -->

                                    <Button x:Name="HeroMyListButton"
                                            Content="＋  MY LIST"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Focusable="True"
                                            IsTabStop="True"
                                            Margin="14,0,0,0"
                                            MinWidth="150"
                                            MinHeight="52"
                                            FontSize="15"/>

                                </StackPanel>

                            </Grid>


                            <!-- ================================================= -->
                            <!-- HERO CAROUSEL INDICATORS                          -->
                            <!-- ================================================= -->

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,18">


                                <Button x:Name="HeroIndicator1"
                                        Style="{DynamicResource HeroIndicatorButtonStyle}"
                                        Click="HeroIndicator1_Click">

                                    <Ellipse x:Name="HeroIndicatorEllipse1"
                                             Width="9"
                                             Height="9"
                                             Fill="#FF2A78"/>

                                </Button>


                                <Button x:Name="HeroIndicator2"
                                        Style="{DynamicResource HeroIndicatorButtonStyle}"
                                        Click="HeroIndicator2_Click">

                                    <Ellipse x:Name="HeroIndicatorEllipse2"
                                             Width="9"
                                             Height="9"
                                             Fill="#77777F"/>

                                </Button>


                                <Button x:Name="HeroIndicator3"
                                        Style="{DynamicResource HeroIndicatorButtonStyle}"
                                        Click="HeroIndicator3_Click">

                                    <Ellipse x:Name="HeroIndicatorEllipse3"
                                             Width="9"
                                             Height="9"
                                             Fill="#77777F"/>

                                </Button>


                                <Button x:Name="HeroIndicator4"
                                        Style="{DynamicResource HeroIndicatorButtonStyle}"
                                        Click="HeroIndicator4_Click">

                                    <Ellipse x:Name="HeroIndicatorEllipse4"
                                             Width="9"
                                             Height="9"
                                             Fill="#77777F"/>

                                </Button>


                                <Button x:Name="HeroIndicator5"
                                        Style="{DynamicResource HeroIndicatorButtonStyle}"
                                        Click="HeroIndicator5_Click">

                                    <Ellipse x:Name="HeroIndicatorEllipse5"
                                             Width="9"
                                             Height="9"
                                             Fill="#77777F"/>

                                </Button>

                            </StackPanel>
                            
                        </Grid>

                    </Grid>

                </Grid>


                <!-- ===================================================== -->
                <!-- MEDIA CONTENT                                           -->
                <!-- ===================================================== -->

                <StackPanel Margin="45,0,45,60">


                    <!-- ================================================= -->
                    <!-- CONTINUE WATCHING                                  -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="ContinueWatchingSection"
                        Title="CONTINUE WATCHING"
                        Items="{Binding ContinueWatching}"/>


                    <!-- ================================================= -->
                    <!-- MY LIST                                             -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="MyListSection"
                        Title="MY LIST"
                        Items="{Binding MyList}"/>


                    <!-- ================================================= -->
                    <!-- RECENTLY ADDED                                      -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="RecentlyAddedSection"
                        Title="RECENTLY ADDED"
                        Items="{Binding RecentlyAdded}"/>


                    <!-- ================================================= -->
                    <!-- TOP MOVIES                                          -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="TopMoviesSection"
                        Title="TOP 10 MOVIES"
                        Items="{Binding TopMovies}"/>


                    <!-- ================================================= -->
                    <!-- TOP TV SHOWS                                        -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="TopShowsSection"
                        Title="TOP 10 TV SHOWS"
                        Items="{Binding TopShows}"/>


                    <!-- ================================================= -->
                    <!-- TOP ANIME                                           -->
                    <!-- ================================================= -->

                    <controls:MediaSection
                        x:Name="TopAnimeSection"
                        Title="TOP 10 ANIME"
                        Items="{Binding TopAnime}"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>
        <Grid
            x:Name="PlaybackTestHost"
            Panel.ZIndex="1000"
            Background="Black"
            Visibility="Collapsed" />

        <!-- ========================================================= -->
        <!-- SOURCE SELECTOR HOST (Slice 9)                            -->
        <!-- ========================================================= -->
        <!--
            Separate from PlaybackTestHost even though the two are never
            visible at the same time - the selector is created fresh and
            torn down per selection, while PlaybackTestHost's child
            (_stremioPlayer) is reused across a whole viewing session.
            Sharing one Grid's Children between two differently-lived
            things was judged not worth the small extra XAML to avoid.
        -->
        <Grid
            x:Name="SourceSelectorHost"
            Panel.ZIndex="1000"
            Background="Black"
            Visibility="Collapsed" />

        <!-- ========================================================= -->
        <!-- EPISODE BROWSER HOST (Slice 12)                            -->
        <!-- ========================================================= -->
        <!--
            Same reasoning as SourceSelectorHost being separate from
            PlaybackTestHost: this overlay has its own short-lived
            lifecycle (created fresh per TV-show selection, torn down on
            episode pick or cancellation), distinct from both the player
            and the source selector, so it gets its own host rather than
            sharing either of theirs.
        -->
        <Grid
            x:Name="EpisodeBrowserHost"
            Panel.ZIndex="1000"
            Background="Black"
            Visibility="Collapsed" />

    </Grid>

</PluginUserControl>
