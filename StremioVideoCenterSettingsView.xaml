<UserControl
    x:Class="StremioVideoCenter.StremioVideoCenterSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <!-- ========================================================= -->
        <!-- MAIN SETTINGS PANEL                                       -->
        <!-- ========================================================= -->

        <StackPanel Margin="10">

            <!-- ========================================================= -->
            <!-- TITLE                                                     -->
            <!-- ========================================================= -->

            <TextBlock
                Text="Stremio Video Center"
                FontWeight="Bold"
                FontSize="16"
                Margin="0,0,0,20"/>


            <!-- ========================================================= -->
            <!-- TMDB SETTINGS                                              -->
            <!-- ========================================================= -->

            <TextBlock
                Text="TMDB"
                FontWeight="Bold"
                FontSize="14"
                Margin="0,0,0,8"/>

            <TextBlock
                Text="TMDB API Key / Read Access Token"
                Margin="0,0,0,5"/>

            <PasswordBox
                x:Name="TmdbApiKeyBox"
                Height="28"
                Margin="0,0,0,5"
                PasswordChanged="TmdbApiKeyBox_PasswordChanged"/>

            <StackPanel
                Margin="0,0,0,20">

                <TextBlock
                    Text="Your TMDB credential is stored with the plugin settings."
                    Opacity="0.65"
                    FontSize="11"
                    Margin="0,0,0,8"/>

                <Button
                    x:Name="TestTmdbConnectionButton"
                    Content="Test TMDB Connection"
                    Width="180"
                    Height="30"
                    HorizontalAlignment="Left"
                    Click="TestTmdbConnection_Click"/>

                <TextBlock
                    x:Name="TmdbConnectionStatus"
                    Margin="0,8,0,0"
                    FontSize="11"
                    TextWrapping="Wrap"/>


                <!-- ========================================================= -->
                <!-- TMDB DISCOVERY TEST                                        -->
                <!-- ========================================================= -->

                <Button
                    x:Name="TestTmdbDiscoveryButton"
                    Content="Test TMDB Discovery"
                    Width="180"
                    Height="30"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    Click="TestTmdbDiscovery_Click"/>

                <TextBlock
                    x:Name="TmdbDiscoveryStatus"
                    Margin="0,8,0,0"
                    FontSize="11"
                    TextWrapping="Wrap"/>

            </StackPanel>


            <!-- ========================================================= -->
            <!-- OMDB SETTINGS                                              -->
            <!-- ========================================================= -->

            <TextBlock
                Text="OMDb"
                FontWeight="Bold"
                FontSize="14"
                Margin="0,0,0,8"/>

            <TextBlock
                Text="OMDb API Key"
                Margin="0,0,0,5"/>

            <PasswordBox
                x:Name="OmdbApiKeyBox"
                Height="28"
                Margin="0,0,0,5"
                PasswordChanged="OmdbApiKeyBox_PasswordChanged"/>

            <StackPanel>

                <TextBlock
                    Text="Used for additional movie and TV metadata."
                    Opacity="0.65"
                    FontSize="11"
                    Margin="0,0,0,8"/>

                <Button
                    x:Name="TestOmdbConnectionButton"
                    Content="Test OMDb Connection"
                    Width="180"
                    Height="30"
                    HorizontalAlignment="Left"
                    Click="TestOmdbConnection_Click"/>

                <TextBlock
                    x:Name="OmdbConnectionStatus"
                    Margin="0,8,0,0"
                    FontSize="11"
                    TextWrapping="Wrap"/>

            </StackPanel>


            <!-- ========================================================= -->
            <!-- REAL-DEBRID SETTINGS                                       -->
            <!-- ========================================================= -->

            <TextBlock
                Text="Real-Debrid"
                FontWeight="Bold"
                FontSize="14"
                Margin="0,20,0,8"/>

            <TextBlock
                Text="Real-Debrid API Token"
                Margin="0,0,0,5"/>

            <PasswordBox
                x:Name="RealDebridApiKeyBox"
                Height="28"
                Margin="0,0,0,5"
                PasswordChanged="RealDebridApiKeyBox_PasswordChanged"/>

            <StackPanel>

                <TextBlock
                    Text="Used to resolve torrent-based Stremio streams into direct playable links."
                    Opacity="0.65"
                    FontSize="11"
                    Margin="0,0,0,8"/>

                <Button
                    x:Name="TestRealDebridConnectionButton"
                    Content="Test Real-Debrid Connection"
                    Width="180"
                    Height="30"
                    HorizontalAlignment="Left"
                    Click="TestRealDebridConnection_Click"/>

                <TextBlock
                    x:Name="RealDebridConnectionStatus"
                    Margin="0,8,0,0"
                    FontSize="11"
                    TextWrapping="Wrap"/>

            </StackPanel>


            <!-- ========================================================= -->
            <!-- CONTENT DISCOVERY TEST                                     -->
            <!-- ========================================================= -->

            <TextBlock
                Text="Content Discovery"
                FontWeight="Bold"
                FontSize="14"
                Margin="0,20,0,8"/>

            <StackPanel>

                <TextBlock
                    Text="Proves the TMDB -&gt; Stremio content-id pipeline for a movie, a TV episode, and an anime episode. Requires a TMDB credential above; uses the local test addon."
                    Opacity="0.65"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Margin="0,0,0,8"/>

                <Button
                    x:Name="TestContentDiscoveryButton"
                    Content="Test Content Discovery"
                    Width="180"
                    Height="30"
                    HorizontalAlignment="Left"
                    Click="TestContentDiscovery_Click"/>

                <TextBlock
                    x:Name="ContentDiscoveryStatus"
                    Margin="0,8,0,0"
                    FontSize="11"
                    TextWrapping="Wrap"/>

            </StackPanel>


            <!-- ========================================================= -->
            <!-- STREMIO ADDONS                                             -->
            <!-- ========================================================= -->

            <TextBlock
                Text="Stremio Addons"
                FontWeight="Bold"
                FontSize="14"
                Margin="0,20,0,8"/>

            <TextBlock
                Text="One manifest/base addon URL per line."
                Margin="0,0,0,5"/>

            <TextBox
                x:Name="StremioAddonUrlsBox"
                Height="80"
                Margin="0,0,0,5"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                TextChanged="StremioAddonUrlsBox_TextChanged"/>

            <StackPanel>

                <TextBlock
                    Text="The local test addon is included by default so existing regression testing continues to work."
                    Opacity="0.65"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Margin="0,0,0,8"/>

                <Button
                    x:Name="TestConfiguredAddonsButton"
                    Content="Test Configured Addons"
                    Width="180"
                    Height="30"
                    HorizontalAlignment="Left"
                    Click="TestConfiguredAddons_Click"/>

                <TextBlock
                    x:Name="AddonTestStatus"
                    Margin="0,8,0,0"
                    FontSize="11"
                    TextWrapping="Wrap"/>

            </StackPanel>


            <!-- ========================================================= -->
            <!-- SOURCE AGGREGATION TEST                                    -->
            <!-- ========================================================= -->

            <TextBlock
                Text="Source Aggregation"
                FontWeight="Bold"
                FontSize="14"
                Margin="0,20,0,8"/>

            <StackPanel>

                <TextBlock
                    Text="Proves the full backend: configured addons -&gt; aggregated streams -&gt; resolved candidate playback sources (Direct and Real-Debrid), deduplicated, for a movie, a TV episode, and an anime episode."
                    Opacity="0.65"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Margin="0,0,0,8"/>

                <Button
                    x:Name="TestSourceAggregationButton"
                    Content="Test Source Aggregation"
                    Width="180"
                    Height="30"
                    HorizontalAlignment="Left"
                    Click="TestSourceAggregation_Click"/>

                <TextBlock
                    x:Name="SourceAggregationStatus"
                    Margin="0,8,0,0"
                    FontSize="11"
                    TextWrapping="Wrap"/>

            </StackPanel>

        </StackPanel>

    </Grid>

</UserControl>